---
import type { FormulaAnimation } from '../../types/study';

interface Props {
  formula: FormulaAnimation;
}

const { formula } = Astro.props;
---

<div
  class="gsap-morph-player rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-xs flex flex-col my-8 select-none focus-within:ring-2 focus-within:ring-blue-600 outline-none min-w-0 max-w-full overflow-hidden"
  tabindex="0"
  role="region"
  aria-label={`Formula Derivation Player: ${formula.name}`}
  data-formula-id={formula.id}
  data-formula-json={JSON.stringify(formula)}
>
  <!-- Player Top Bar (Hallmark Modern-Minimal Header) -->
  <div class="bg-slate-950 text-slate-100 px-4 sm:px-6 py-3.5 flex flex-wrap justify-between items-center gap-3 border-b border-slate-800/80 min-w-0 max-w-full">
    <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
      <span class="rounded-md px-2 py-0.5 bg-blue-500/15 text-blue-400 border border-blue-500/30 text-[10px] font-mono font-bold tracking-wider uppercase shrink-0">
        {formula.category.toUpperCase()}
      </span>
      <h3 class="font-['Space_Grotesk',_sans-serif] font-bold text-base sm:text-lg tracking-tight text-white truncate flex items-center gap-1.5">
        <span>{formula.name}</span>
        <span class="text-slate-500 font-normal">·</span>
        <span class="text-blue-300 font-medium">{formula.thaiName}</span>
      </h3>
    </div>
    <div class="flex items-center gap-2.5 text-xs font-mono shrink-0">
      <span class="px-2.5 py-1 text-slate-300 bg-slate-800/90 border border-slate-700/80 rounded-md text-[11px] font-medium">
        {formula.lectureRef}
      </span>
      <button
        type="button"
        data-audio-toggle
        data-audio-context="header"
        class="audio-toggle-btn btn-primary px-3.5 py-1.5 rounded-lg text-xs font-mono font-semibold bg-blue-600 hover:bg-blue-500 text-white transition-colors cursor-pointer shadow-xs flex items-center gap-1.5 outline-none focus-visible:ring-2 focus-visible:ring-blue-400"
        title="เล่นแอนิเมชันและเสียงบรรยายภาษาไทยอัตโนมัติจนจบขั้นตอน"
      >
        <svg class="w-3.5 h-3.5 shrink-0" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <span data-audio-text>เล่นอัตโนมัติพร้อมเสียงไทย</span>
      </button>
    </div>
  </div>

  <!-- Progress Bar (Hallmark 2px Precision Progress Indicator) -->
  <div class="h-0.5 bg-slate-800/80 relative overflow-hidden">
    <div
      data-progress-bar
      class="h-full bg-blue-500 transition-all duration-300 ease-out"
      style="width: 0%"
    ></div>
  </div>

  <!-- Main Body: Dual-Zone Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 border-b border-slate-200 dark:border-slate-800 min-w-0 max-w-full">
    <!-- Left: Authentic Data Source Table (Monospace & Tabular) -->
    <div class="lg:col-span-5 p-4 sm:p-5 bg-slate-50/70 dark:bg-slate-900/60 border-b lg:border-b-0 lg:border-r border-slate-200 dark:border-slate-800 overflow-x-auto min-w-0 max-w-full">
      <div class="flex items-center gap-2 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500 inline-block"></span>
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200">
          ตารางข้อมูลตั้งต้น (Evidence Table)
        </span>
      </div>

      <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 overflow-hidden shadow-2xs">
        <table class="w-full text-left text-xs font-mono border-collapse">
          <thead>
            <tr class="bg-slate-50 dark:bg-slate-800/60 text-slate-700 dark:text-slate-300 border-b border-slate-200 dark:border-slate-800">
              {formula.dataset.headers.map((h) => (
                <th class="p-2.5 border-r border-slate-200 dark:border-slate-800 font-bold text-[11px] tracking-tight last:border-r-0">{h.label}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            {formula.dataset.rows.map((row, rowIdx) => (
              <tr 
                class="hover:bg-slate-50/60 dark:hover:bg-slate-800/40 transition-colors data-row"
                style={`animation: fadeInRow 0.3s ease-out ${rowIdx * 0.05}s both`}
              >
                {formula.dataset.headers.map((h) => {
                  const cell = row.cells[h.key];
                  return (
                    <td
                      class="p-2.5 border-r border-slate-100 dark:border-slate-800 last:border-r-0 zone-b-cell tabular-nums font-semibold transition-colors duration-150"
                      data-source-cell-id={cell?.id}
                      data-semantic={cell?.semantic || 'neutral'}
                    >
                      {cell?.value ?? '-'}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Base Formula reference snippet -->
      <div class="mt-3.5 p-3 bg-white dark:bg-slate-900 rounded-xl border border-slate-200 dark:border-slate-800 text-[11px] font-mono shadow-2xs">
        <span class="font-bold text-slate-800 dark:text-slate-200">สมการตั้งต้น:</span>
        <code class="ml-1.5 text-blue-600 dark:text-blue-400 font-bold">{formula.baseFormulaLatex}</code>
      </div>
    </div>

    <!-- Right: KaTeX Animated Derivation Display -->
    <div
      data-derivation-stage
      class="lg:col-span-7 min-w-0 max-w-full p-4 sm:p-6 bg-white dark:bg-slate-950 flex flex-col justify-between items-center relative overflow-hidden min-h-[340px] sm:min-h-[350px]"
    >
      <!-- KaTeX Equation Mount Point (Locked stable height to eliminate vertical jumping) -->
      <div
        data-katex-mount
        class="katex-mount w-full max-w-full min-w-0 h-[105px] sm:h-[115px] py-2 px-2 flex justify-center items-center text-xl sm:text-2xl text-slate-900 dark:text-slate-100 font-mono tabular-nums overflow-x-auto overflow-y-hidden shrink-0"
      >
        <!-- Injected via FormulaMorphEngine -->
      </div>

      <!-- Current Step Explanation Box (Stabilized container height across all frames) -->
      <div
        data-explanation-box
        class="w-full mt-3 p-4 sm:p-5 bg-slate-50/80 dark:bg-slate-900/60 rounded-xl border border-slate-200/90 dark:border-slate-800 text-xs sm:text-sm min-w-0 max-w-full overflow-hidden flex flex-col justify-between min-h-[175px] sm:min-h-[165px]"
      >
        <div class="space-y-2.5">
          <div class="flex flex-wrap items-center justify-between gap-2 pb-2.5 border-b border-slate-200/70 dark:border-slate-800">
            <div class="flex items-center gap-2 min-w-0">
              <span class="px-2 py-0.5 rounded-md bg-slate-900 dark:bg-blue-600 text-white text-xs font-mono font-bold shrink-0">
                สเต็ป <span data-step-indicator>1</span> / {formula.steps.length}
              </span>
              <h4 data-step-title class="font-bold text-slate-900 dark:text-slate-100 text-sm sm:text-base font-['Space_Grotesk',_sans-serif] truncate">
                {formula.steps[0].title}
              </h4>
            </div>

            <!-- Direct In-Context Step Audio Button -->
            <button
              type="button"
              data-audio-toggle
              data-audio-context="step"
              aria-pressed="false"
              aria-label="ฟังเสียงบรรยายขั้นตอนนี้"
              class="btn-secondary rounded-lg px-3 py-1 text-xs font-mono font-bold cursor-pointer transition-colors shrink-0 flex items-center gap-1.5 text-slate-700 dark:text-slate-200 hover:text-blue-600"
              title="ฟังเสียงบรรยายขั้นตอนการคำนวณนี้"
            >
              <svg class="w-3.5 h-3.5 shrink-0 text-blue-600" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <span data-audio-text>ฟังเสียงอธิบายสเต็ปนี้</span>
            </button>
          </div>

          <p data-step-explanation class="text-slate-700 dark:text-slate-300 font-medium leading-relaxed text-xs sm:text-sm font-sans break-words">
            {formula.steps[0].explanation}
          </p>
        </div>

        <!-- Exam Trap Warning (High-Contrast Hallmark Callout) -->
        <div
          data-trap-box
          class="hidden mt-3 p-3 rounded-lg bg-rose-50/80 dark:bg-rose-500/15 border border-rose-200 dark:border-rose-500/35 text-xs font-mono text-rose-900 dark:text-rose-200 origin-top shrink-0"
        >
          <div class="flex items-center gap-1.5 font-bold text-rose-700 dark:text-rose-300 mb-0.5">
            <svg class="w-3.5 h-3.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span>กับดักข้อสอบอาจารย์:</span>
          </div>
          <span data-trap-text class="text-slate-800 dark:text-rose-100 font-sans text-xs leading-relaxed"></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Player Controls (Zone B Hallmark Workbench Controls) -->
  <div class="bg-slate-50/70 dark:bg-slate-900/80 px-4 sm:px-6 py-3.5 flex flex-wrap justify-between items-center gap-3 border-t border-slate-200 dark:border-slate-800 min-w-0 max-w-full">
    <!-- Left: Prev / Next Buttons (rounded-lg) -->
    <div class="flex items-center gap-2 shrink-0">
      <button
        type="button"
        data-prev-step
        class="control-btn btn-secondary px-3.5 py-1.5 text-xs font-mono font-semibold rounded-lg cursor-pointer focus-visible:ring-2 focus-visible:ring-blue-500 outline-none transition-colors disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1"
        aria-label="ย้อนกลับสเต็ปก่อนหน้า"
      >
        <span>←</span>
        <span>สเต็ปก่อนหน้า</span>
      </button>
      <button
        type="button"
        data-next-step
        class="control-btn btn-primary px-4 py-1.5 text-xs font-mono font-semibold rounded-lg bg-slate-900 text-white hover:bg-slate-800 cursor-pointer focus-visible:ring-2 focus-visible:ring-blue-500 outline-none transition-colors disabled:opacity-40 disabled:cursor-not-allowed flex items-center gap-1 shadow-2xs"
        aria-label="ไปยังสเต็ปถัดไป"
      >
        <span>สเต็ปถัดไป</span>
        <span>→</span>
      </button>
    </div>

    <!-- Center: Step Scrubber Dots -->
    <div class="flex items-center gap-1.5 flex-wrap shrink-0" role="group" aria-label="Step navigation">
      {formula.steps.map((_, idx) => (
        <button
          type="button"
          data-step-dot={idx + 1}
          aria-label={`ไปยังสเต็ปที่ ${idx + 1}`}
          class:list={[
            'step-dot w-7 h-7 rounded-lg text-xs font-mono font-bold flex items-center justify-center cursor-pointer transition-colors shadow-2xs',
            idx === 0
              ? 'bg-slate-900 text-white dark:bg-blue-600 shadow-xs'
              : 'border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-slate-400',
          ]}
        >
          {idx + 1}
        </button>
      ))}
    </div>

    <!-- Right: 1-Line Memory Rule & Keyboard Shortcuts -->
    <div class="flex items-center gap-2 flex-wrap min-w-0">
      <!-- 1-Line Memory Rule with SVG Bulb -->
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-amber-500/10 border border-amber-500/25 text-[11px] font-mono text-slate-800 dark:text-slate-200 shadow-2xs">
        <svg class="w-3.5 h-3.5 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.87-3.13-7-7-7zm-2 18c0 .55.45 1 1 1h2c.55 0 1-.45 1-1v-1h-4v1z"/>
        </svg>
        <span class="font-bold text-amber-700 dark:text-amber-400 shrink-0">สูตรจำ:</span>
        <span class="font-normal text-slate-700 dark:text-slate-300 truncate max-w-[280px] sm:max-w-md">{formula.oneLineRule}</span>
      </div>

      <!-- Keyboard shortcuts badge with SVG Keyboard -->
      <span class="hidden xl:inline-flex items-center gap-1.5 px-2 py-1 rounded-lg bg-slate-100 dark:bg-slate-800/60 border border-slate-200/80 dark:border-slate-700 text-slate-500 dark:text-slate-400 text-[10px] font-mono">
        <svg class="w-3 h-3 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <rect x="2" y="4" width="20" height="16" rx="2"/>
          <path d="M6 8h.01M10 8h.01M14 8h.01M18 8h.01M6 12h.01M10 12h.01M14 12h.01M18 12h.01M7 16h10"/>
        </svg>
        <span>[← / → เลื่อน] [Space เสียง] [R รีเซ็ต]</span>
      </span>
    </div>
  </div>
</div>

<style is:global>
  /* Entry Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInLeft {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInRight {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInRow {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes waveSweep {
    0% {
      opacity: 0.2;
    }
    50% {
      opacity: 0.8;
    }
    100% {
      opacity: 0.2;
    }
  }

  @keyframes morphIn {
    0% {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
      filter: blur(4px);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.02) translateY(-2px);
      filter: blur(1px);
    }
    100% {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0);
    }
  }

  @keyframes morphOut {
    0% {
      opacity: 1;
      transform: scale(1) translateY(0);
      filter: blur(0);
    }
    100% {
      opacity: 0;
      transform: scale(0.95) translateY(-10px);
      filter: blur(4px);
    }
  }

  @keyframes highlightPulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(163, 230, 53, 0.7);
    }
    50% {
      box-shadow: 0 0 0 8px rgba(163, 230, 53, 0);
    }
  }

  @keyframes stepChange {
    0% {
      opacity: 1;
      transform: translateY(0);
    }
    30% {
      opacity: 0;
      transform: translateY(-8px);
    }
    31% {
      opacity: 0;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes trapSlideIn {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @keyframes shake {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-2px); }
  }

  /* KaTeX Mount Animation Classes */
  .katex-mount .katex-equation-enter {
    animation: morphIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .katex-mount .katex-equation-exit {
    animation: morphOut 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .katex-mount .katex-equation-morph {
    animation: morphIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }
  .katex-mount .katex-display {
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden !important;
    margin: 0 !important;
    padding: 2px 0 !important;
    min-width: 0;
    white-space: nowrap;
  }
  .katex-mount .katex {
    max-width: 100%;
    min-width: 0;
  }
  .katex-mount .katex-display > .katex {
    font-size: 1.15em;
  }
  @media (max-width: 640px) {
    .katex-mount .katex-display > .katex {
      font-size: 0.95em;
    }
  }

  /* Step content transition */
  .step-content-transitioning {
    animation: stepChange 0.4s ease-in-out;
  }

  /* Trap box animation */
  [data-trap-box].trap-visible {
    animation: trapSlideIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  [data-trap-box].trap-shake {
    animation: shake 0.5s ease-in-out;
  }

  /* Audio playing states */
  .audio-playing .audio-wave-indicator {
    display: block !important;
  }

  .audio-playing {
    animation: highlightPulse 2s ease-in-out infinite;
  }

  /* Step dot active state */
  .step-dot-active {
    animation: highlightPulse 0.6s ease-out;
  }

  /* Control button containment */
  .control-btn {
    position: relative;
    overflow: hidden;
  }

  /* Progress bar animation */
  .progress-updating {
    animation: progressPulse 0.3s ease-out;
  }

  @keyframes progressPulse {
    0% { opacity: 1; }
    50% { opacity: 0.7; }
    100% { opacity: 1; }
  }

  /* Highlight animation for data cells */
  .zone-b-cell.highlight-flash {
    animation: cellFlash 0.8s ease-out;
  }

  @keyframes cellFlash {
    0% { background-color: transparent; }
    30% { background-color: rgba(163, 230, 53, 0.3); }
    100% { background-color: transparent; }
  }

  /* Smooth transitions for text content without flashing to opacity 0 */
  [data-step-title],
  [data-step-explanation],
  [data-step-indicator] {
    transition: opacity 0.15s ease-out;
  }

  .step-content-transitioning {
    opacity: 0.6;
  }

  /* Disabled state for buttons */
  .control-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .control-btn:disabled:active {
    transform: none !important;
    box-shadow: none !important;
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .katex-mount {
      font-size: 1rem;
    }
  }
</style>

<script>
  import { FormulaMorphEngine } from './morph-engine';
  import type { FormulaAnimation } from '../../types/study';

  document.querySelectorAll<HTMLElement>('.gsap-morph-player').forEach((playerEl) => {
    const rawJson = playerEl.getAttribute('data-formula-json');
    if (!rawJson) return;

    try {
      const formula: FormulaAnimation = JSON.parse(rawJson);

      const stepIndicator = playerEl.querySelector<HTMLElement>('[data-step-indicator]');
      const stepTitle = playerEl.querySelector<HTMLElement>('[data-step-title]');
      const stepExplanation = playerEl.querySelector<HTMLElement>('[data-step-explanation]');
      const trapBox = playerEl.querySelector<HTMLElement>('[data-trap-box]');
      const trapText = playerEl.querySelector<HTMLElement>('[data-trap-text]');
      const stepDots = playerEl.querySelectorAll<HTMLElement>('[data-step-dot]');
      const progressBar = playerEl.querySelector<HTMLElement>('[data-progress-bar]');
      const prevBtn = playerEl.querySelector<HTMLButtonElement>('[data-prev-step]');
      const nextBtn = playerEl.querySelector<HTMLButtonElement>('[data-next-step]');
      const audioButtons = playerEl.querySelectorAll<HTMLButtonElement>('[data-audio-toggle]');
      const explanationBox = playerEl.querySelector<HTMLElement>('[data-explanation-box]');

      function stabilizeBoxHeight() {
        if (!explanationBox) return;

        const targetWidth = explanationBox.clientWidth;
        if (targetWidth <= 0) return;

        // Clone off-screen to measure max height across all steps of this formula
        const clone = explanationBox.cloneNode(true) as HTMLElement;
        clone.style.position = 'absolute';
        clone.style.left = '-9999px';
        clone.style.top = '-9999px';
        clone.style.visibility = 'hidden';
        clone.style.pointerEvents = 'none';
        clone.style.height = 'auto';
        clone.style.minHeight = '0';
        clone.style.maxHeight = 'none';
        clone.style.boxSizing = 'border-box';
        clone.style.width = `${targetWidth}px`;

        document.body.appendChild(clone);

        let maxHeight = 0;
        const cTitle = clone.querySelector<HTMLElement>('[data-step-title]');
        const cExp = clone.querySelector<HTMLElement>('[data-step-explanation]');
        const cTrap = clone.querySelector<HTMLElement>('[data-trap-box]');
        const cTrapText = clone.querySelector<HTMLElement>('[data-trap-text]');

        formula.steps.forEach((step) => {
          if (cTitle) cTitle.textContent = step.title;
          if (cExp) cExp.textContent = step.explanation;
          if (cTrap && cTrapText) {
            if (step.examTrapWarning) {
              cTrapText.textContent = step.examTrapWarning;
              cTrap.classList.remove('hidden');
            } else {
              cTrap.classList.add('hidden');
            }
          }
          const h = clone.offsetHeight;
          if (h > maxHeight) {
            maxHeight = h;
          }
        });

        document.body.removeChild(clone);

        if (maxHeight > 0) {
          // Lock to the max step height with 2px buffer for subpixel font rendering variations
          explanationBox.style.minHeight = `${maxHeight + 2}px`;
        }
      }

      let isTransitioning = false;
      let currentStepIndex = 1;

      const engine = new FormulaMorphEngine(playerEl, formula, (stepIdx) => {
        if (isTransitioning) return;
        
        const step = formula.steps.find((s) => s.stepIndex === stepIdx);
        if (!step) return;

        isTransitioning = true;

        // Smooth text content updates without jarring flicker
        if (stepIndicator) {
          stepIndicator.textContent = String(stepIdx);
        }

        if (stepTitle) {
          stepTitle.classList.add('step-content-transitioning');
          stepTitle.textContent = step.title;
          setTimeout(() => {
            stepTitle.classList.remove('step-content-transitioning');
          }, 120);
        }

        if (stepExplanation) {
          stepExplanation.classList.add('step-content-transitioning');
          stepExplanation.textContent = step.explanation;
          setTimeout(() => {
            stepExplanation.classList.remove('step-content-transitioning');
          }, 120);
        }

        // Trap Warning with animation
        if (trapBox && trapText) {
          if (step.examTrapWarning) {
            trapText.textContent = step.examTrapWarning;
            trapBox.classList.remove('hidden');
            trapBox.classList.add('trap-visible');
            setTimeout(() => {
              trapBox.classList.add('trap-shake');
              setTimeout(() => trapBox.classList.remove('trap-shake'), 500);
            }, 400);
          } else {
            trapBox.classList.remove('trap-visible');
            setTimeout(() => trapBox.classList.add('hidden'), 300);
          }
        }

        // Update progress bar
        if (progressBar) {
          const progress = ((stepIdx - 1) / (formula.steps.length - 1)) * 100;
          progressBar.style.width = `${progress}%`;
          progressBar.classList.add('progress-updating');
          setTimeout(() => progressBar.classList.remove('progress-updating'), 300);
        }

        // Update Dots with animations
        stepDots.forEach((dot) => {
          const dotIdx = Number(dot.getAttribute('data-step-dot'));
          if (dotIdx === stepIdx) {
            dot.className =
              'step-dot step-dot-active w-7 h-7 rounded-lg text-xs font-mono font-bold flex items-center justify-center bg-slate-900 text-white dark:bg-blue-600 shadow-xs cursor-pointer outline-none transition-colors';
          } else {
            dot.className =
              'step-dot w-7 h-7 rounded-lg text-xs font-mono font-bold flex items-center justify-center border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:border-slate-400 shadow-2xs cursor-pointer outline-none transition-colors';
          }
        });

        // Update button states
        currentStepIndex = stepIdx;
        updateButtonStates();

        setTimeout(() => {
          isTransitioning = false;
        }, 500);
      });

      function updateButtonStates() {
        if (prevBtn) {
          prevBtn.disabled = currentStepIndex <= 1;
        }
        if (nextBtn) {
          nextBtn.disabled = currentStepIndex >= formula.steps.length;
        }
      }

      engine.init();
      updateButtonStates();
      stabilizeBoxHeight();

      document.fonts.ready.then(() => {
        stabilizeBoxHeight();
      });

      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              stabilizeBoxHeight();
              observer.disconnect();
            }
          });
        }, { threshold: 0.05 });
        observer.observe(playerEl);
      }

      let resizeTimer: ReturnType<typeof setTimeout>;
      window.addEventListener('resize', () => {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(stabilizeBoxHeight, 150);
      });

      // Controls
      prevBtn?.addEventListener('click', () => {
        if (!isTransitioning) engine.prevStep();
      });
      
      nextBtn?.addEventListener('click', () => {
        if (!isTransitioning) engine.nextStep();
      });

      audioButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const isPlaying = btn.classList.contains('audio-playing');
          const isHeaderBtn = btn.getAttribute('data-audio-context') === 'header';

          if (!isPlaying) {
            if (isHeaderBtn) {
              engine.startAutoPlay();
            } else {
              engine.playStepAudio();
            }
          } else {
            engine.stopAudio();
          }
        });
      });

      stepDots.forEach((dot) => {
        dot.addEventListener('click', () => {
          if (isTransitioning) return;
          const idx = Number(dot.getAttribute('data-step-dot'));
          engine.goToStep(idx, true);
        });
      });

      // Keyboard Accessibility
      playerEl.addEventListener('keydown', (e) => {
        if (isTransitioning) return;
        
        if (e.key === 'ArrowRight' || e.key === 'l' || e.key === 'L') {
          e.preventDefault();
          engine.nextStep();
        } else if (e.key === 'ArrowLeft' || e.key === 'h' || e.key === 'H') {
          e.preventDefault();
          engine.prevStep();
        } else if (e.key === ' ' || e.key === 'k' || e.key === 'K') {
          e.preventDefault();
          const firstAudioBtn = playerEl.querySelector<HTMLButtonElement>('[data-audio-toggle]');
          firstAudioBtn?.click();
        } else if (e.key === 'r' || e.key === 'R' || e.key === 'Home') {
          e.preventDefault();
          engine.goToStep(1, true);
        }
      });

      // Highlight related data cells when hovering equation
      const katexMount = playerEl.querySelector('[data-katex-mount]');
      katexMount?.addEventListener('mouseenter', () => {
        const cells = playerEl.querySelectorAll('.zone-b-cell');
        cells.forEach((cell, idx) => {
          setTimeout(() => {
            cell.classList.add('highlight-flash');
            setTimeout(() => cell.classList.remove('highlight-flash'), 800);
          }, idx * 100);
        });
      });

    } catch (err) {
      console.error('Failed to init formula player:', err);
    }
  });
</script>