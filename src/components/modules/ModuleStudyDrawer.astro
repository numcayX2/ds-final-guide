---
import type { StudyModule } from '../../types/study';

interface Props {
  modules: StudyModule[];
}

const { modules } = Astro.props;
---

<!-- Ultra-Detailed Visual Study Drawer / Modal -->
<div
  id="module-study-modal"
  class="fixed inset-0 z-50 hidden bg-[#0F172A]/40 backdrop-blur-[2px] overflow-y-auto p-2 sm:p-4 md:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-module-title"
  data-lenis-prevent
>
  <div class="max-w-5xl mx-auto my-4 sm:my-8 bg-white text-[#0F172A] border border-slate-200/90 shadow-[0_25px_60px_-15px_rgba(15,23,42,0.15)] overflow-hidden rounded-3xl">
    {modules.map((mod, idx) => {
      const prevMod = idx > 0 ? modules[idx - 1] : null;
      const nextMod = idx < modules.length - 1 ? modules[idx + 1] : null;

      return (
        <div
          class="module-detail-pane hidden"
          data-module-pane={mod.id}
        >
          <!-- Sticky Top Bar -->
          <div class="sticky top-0 z-30 bg-white/95 backdrop-blur-md text-[#0F172A] px-5 sm:px-8 py-3.5 border-b border-slate-100 flex flex-wrap justify-between items-center gap-3 shadow-2xs">
            <div class="flex items-center gap-3 min-w-0">
              <span class="w-9 h-9 bg-[#EFF6FF] text-[#2563EB] font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] font-bold text-sm flex items-center justify-center border border-[#BFDBFE] rounded-xl shrink-0">
                {mod.moduleNumber}
              </span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono text-slate-500">
                  <span class="text-[#2563EB] font-bold">{mod.lectureCode}</span>
                  <span>•</span>
                  <span>เวลาทบทวน ~{mod.timeEstimateMinutes} นาที</span>
                  {mod.isFinalFocus && (
                    <span class="soft-pill bg-rose-50 border-rose-200 text-rose-700 px-2 py-0.2 font-bold text-[10px]">
                      ออกสอบเน้นๆ (FINAL FOCUS)
                    </span>
                  )}
                </div>
                <h2 id="modal-module-title" class="font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] font-extrabold text-base sm:text-xl text-[#0F172A] truncate">
                  {mod.title}
                </h2>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <!-- Synced Read Status Toggle Button -->
              <button
                type="button"
                class="module-mark-btn inline-flex items-center gap-1.5 px-3 py-1.5 border border-slate-200 bg-slate-50 text-slate-700 hover:text-slate-900 hover:border-slate-400 rounded-lg text-xs font-mono font-semibold transition-colors cursor-pointer"
                data-mod-id={mod.id}
              >
                <span class="mark-icon w-3.5 h-3.5 border border-slate-300 bg-white rounded-sm flex items-center justify-center text-[10px]"></span>
                <span class="mark-label">ทำเครื่องหมายว่าทบทวนแล้ว</span>
              </button>

              <!-- Close Button -->
              <button
                type="button"
                data-close-modal
                class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 rounded-lg font-mono font-semibold text-xs cursor-pointer transition-colors"
                aria-label="ปิดหน้าต่างสรุปบทเรียน (ESC)"
              >
                ✕ ปิด [ESC]
              </button>
            </div>
          </div>

          <!-- Modal Body Content -->
          <div class="p-4 sm:p-6 md:p-8 space-y-8 bg-[#F8FAFC]">
            <!-- Quick Overview Banner -->
            <div class="bg-white border border-[#E2E8F0] p-4 sm:p-5 rounded-[4px] shadow-xs">
              <div class="text-[11px] font-mono font-bold uppercase text-[#2563EB] mb-1">
                OVERVIEW • แก่นสำคัญของบทเรียน ({mod.titleEn})
              </div>
              <p class="text-sm sm:text-base text-[#334155] font-medium leading-relaxed">
                {mod.quickSummary}
              </p>
              {mod.coreFormulas.length > 0 && (
                <div class="mt-3 pt-3 border-t border-[#E2E8F0] flex flex-wrap items-center gap-2">
                  <span class="text-xs font-mono font-bold text-[#64748B]">สูตรคำนวณที่เกี่ยวข้อง:</span>
                  {mod.coreFormulas.map((fId) => (
                    <a
                      href={`/formulas#${fId}`}
                      class="px-2.5 py-1 bg-[#EFF6FF] hover:bg-[#66A1EE] hover:text-white text-[#2563EB] border border-[#BFDBFE] rounded-[3px] font-mono text-xs font-bold transition-all"
                    >
                      เปิดแอนิเมชัน {fId} →
                    </a>
                  ))}
                </div>
              )}
            </div>

            <!-- ========================================================= -->
            <!-- VISUAL MEMORY BLUEPRINTS (เฉพาะแต่ละบทเรียน เพื่อการจำเข้าห้องสอบ) -->
            <!-- ========================================================= -->
            <!-- ========================================================= -->
            <!-- VISUAL MEMORY BLUEPRINTS (สไลด์จริงจากคาบบรรยาย สำหรับทบทวนสอบ) -->
            <!-- ========================================================= -->
            <div class="bg-white p-5 sm:p-7 border border-slate-200/80 rounded-3xl shadow-2xs space-y-6">
              <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200/80 pb-4">
                <div class="flex items-center gap-2.5">
                  <span class="px-2.5 py-1 bg-[#EFF6FF] border border-[#BFDBFE] text-[#2563EB] font-mono text-xs font-bold rounded-lg">
                    LECTURE SLIDES
                  </span>
                  <h3 class="font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] font-bold text-base sm:text-lg text-slate-900">
                    แผนภาพสรุปจากสไลด์บรรยายจริง ({mod.lectureCode})
                  </h3>
                </div>
                <span class="text-[11px] font-mono text-slate-500">
                  🔍 คลิกที่ภาพสไลด์เพื่อเปิดดูภาพขนาดใหญ่เต็มจอ [ZOOM]
                </span>
              </div>

              {/* MODULE 01: CRISP-DS Lifecycle Slides */}
              {mod.id === 'module-01-crisp-ds' && (
                <div class="space-y-6">
                  <!-- Slide 1: Full CRISP-DS Workflow -->
                  <div class="slide-card rounded-2xl border border-slate-200/80 bg-white shadow-2xs overflow-hidden transition-all hover:border-slate-300">
                    <div class="bg-slate-50/90 px-4 py-2.5 border-b border-slate-200/70 flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
                      <div class="flex items-center gap-2 font-bold text-slate-900">
                        <span class="w-2 h-2 rounded-full bg-[#66A1EE]"></span>
                        <span>วงจร CRISP-DS ทั้ง 8 ขั้นตอน (The Complete CRISP-DS Workflow)</span>
                      </div>
                      <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-md bg-white border border-slate-200 text-slate-600 font-semibold text-[11px]">Lect 06 p02</span>
                        <span class="text-[#2563EB] text-[11px] font-semibold cursor-pointer">🔍 ขยายภาพ</span>
                      </div>
                    </div>
                    <div class="p-2 sm:p-4 bg-slate-900/[0.02] flex justify-center cursor-zoom-in">
                      <img
                        src="/slides/L06_p02.png"
                        alt="The Complete CRISP-DS Workflow"
                        class="slide-img w-full max-w-3xl h-auto rounded-xl border border-slate-200/70 shadow-xs hover:brightness-[1.01] transition-all object-contain"
                        loading="lazy"
                        data-slide-src="/slides/L06_p02.png"
                        data-slide-title="วงจร CRISP-DS ทั้ง 8 ขั้นตอน (The Complete CRISP-DS Workflow)"
                        data-slide-ref="Lect 06 p02"
                      />
                    </div>
                    <div class="px-4 py-3 bg-white border-t border-slate-100 space-y-1.5 text-xs">
                      <div class="flex items-start gap-2 text-slate-700">
                        <span class="font-bold text-slate-900 shrink-0 font-mono">★ สาระสำคัญ:</span>
                        <span class="leading-relaxed"><strong>Modeling เป็นเพียงหนึ่งในขั้นตอนของ Data Science Journey—not the whole journey</strong> โดยกระบวนการทั้ง 8 ขั้นตอนเชื่อมโยงกันเป็นวงจรวนซ้ำ (Iterative) และสามารถย้อนกลับไปแก้ไขได้ตลอดเวลา</span>
                      </div>
                      <div class="flex items-start gap-2 text-rose-700 bg-rose-50/50 p-2.5 rounded-xl border border-rose-100 font-medium">
                        <span class="font-bold text-rose-800 shrink-0 font-mono">⚠️ กับดักข้อสอบ:</span>
                        <span class="leading-relaxed">ขั้นตอน <strong>Data Preparation กินเวลามากที่สุดถึง 60–80%</strong> ของโปรเจกต์ และขั้นตอน <strong>AI-assisted Improvement</strong> ต้องเฝ้าระวัง Drift ร่วมกับการมี Human-in-the-Loop</span>
                      </div>
                    </div>
                  </div>

                  <!-- Slide 2: EDA Position in CRISP-DS -->
                  <div class="slide-card rounded-2xl border border-slate-200/80 bg-white shadow-2xs overflow-hidden transition-all hover:border-slate-300">
                    <div class="bg-slate-50/90 px-4 py-2.5 border-b border-slate-200/70 flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
                      <div class="flex items-center gap-2 font-bold text-slate-900">
                        <span class="w-2 h-2 rounded-full bg-[#66A1EE]"></span>
                        <span>ตำแหน่งของ EDA ในกระบวนการ CRISP-DS (CRISP-DS Iterative Workflow)</span>
                      </div>
                      <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-md bg-white border border-slate-200 text-slate-600 font-semibold text-[11px]">Lect 05 p02</span>
                        <span class="text-[#2563EB] text-[11px] font-semibold cursor-pointer">🔍 ขยายภาพ</span>
                      </div>
                    </div>
                    <div class="p-2 sm:p-4 bg-slate-900/[0.02] flex justify-center cursor-zoom-in">
                      <img
                        src="/slides/L05_p02.png"
                        alt="ตำแหน่งของ EDA ในกระบวนการ CRISP-DS"
                        class="slide-img w-full max-w-3xl h-auto rounded-xl border border-slate-200/70 shadow-xs hover:brightness-[1.01] transition-all object-contain"
                        loading="lazy"
                        data-slide-src="/slides/L05_p02.png"
                        data-slide-title="ตำแหน่งของ EDA ในกระบวนการ CRISP-DS"
                        data-slide-ref="Lect 05 p02"
                      />
                    </div>
                    <div class="px-4 py-3 bg-white border-t border-slate-100 text-xs text-slate-700">
                      <span class="font-bold text-slate-900 font-mono">★ สาระสำคัญ:</span>
                      <span class="ml-1 leading-relaxed"><strong>Initial EDA สามารถเริ่มต้นได้ตั้งแต่ขั้น Data Understanding</strong> และทำซ้ำอีกครั้งหลังขั้นตอน Data Preparation เพื่อตรวจทานความถูกต้องก่อนเข้าสู่ Modeling</span>
                    </div>
                  </div>
                </div>
              )}

              {/* MODULE 02: Data Cleaning Visual Blueprint */}
              {mod.id === 'module-02-data-cleaning' && (
                <div class="space-y-6">
                  <!-- Slide: Best Measure of Center -->
                  <div class="slide-card rounded-2xl border border-slate-200/80 bg-white shadow-2xs overflow-hidden transition-all hover:border-slate-300">
                    <div class="bg-slate-50/90 px-4 py-2.5 border-b border-slate-200/70 flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
                      <div class="flex items-center gap-2 font-bold text-slate-900">
                        <span class="w-2 h-2 rounded-full bg-[#66A1EE]"></span>
                        <span>การเลือกใช้ค่ากลางตามลักษณะข้อมูล (Mean vs Median vs Mode)</span>
                      </div>
                      <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-md bg-white border border-slate-200 text-slate-600 font-semibold text-[11px]">Lect 05 p06</span>
                        <span class="text-[#2563EB] text-[11px] font-semibold cursor-pointer">🔍 ขยายภาพ</span>
                      </div>
                    </div>
                    <div class="p-2 sm:p-4 bg-slate-900/[0.02] flex justify-center cursor-zoom-in">
                      <img
                        src="/slides/L05_p06.png"
                        alt="The Best Measure of Center Depends on the Evidence"
                        class="slide-img w-full max-w-3xl h-auto rounded-xl border border-slate-200/70 shadow-xs hover:brightness-[1.01] transition-all object-contain"
                        loading="lazy"
                        data-slide-src="/slides/L05_p06.png"
                        data-slide-title="การเลือกใช้ค่ากลางตามลักษณะข้อมูล (Mean vs Median vs Mode)"
                        data-slide-ref="Lect 05 p06"
                      />
                    </div>
                    <div class="px-4 py-3 bg-white border-t border-slate-100 space-y-1.5 text-xs">
                      <div class="flex items-start gap-2 text-slate-700">
                        <span class="font-bold text-slate-900 shrink-0 font-mono">★ สาระสำคัญ:</span>
                        <span class="leading-relaxed"><strong>Mean:</strong> ใช้กับ Quantitative Data เหมาะเมื่อไม่มี Outlier ครอบงำ / <strong>Median:</strong> ค่ากึ่งกลาง เหมาะเมื่อข้อมูลเบ้หรือมีค่าสุดขั้ว (Skewed/Outlier) / <strong>Mode:</strong> ใช้กับ Categorical Data ที่พบบ่อยที่สุด</span>
                      </div>
                      <div class="flex items-start gap-2 text-rose-700 bg-rose-50/50 p-2.5 rounded-xl border border-rose-100 font-medium">
                        <span class="font-bold text-rose-800 shrink-0 font-mono">⚠️ กฎ Clean Before Impute:</span>
                        <span class="leading-relaxed">ตัด Known Invalid (-40,000 หรือพิมพ์ศูนย์เกิน 904,000) ออกก่อนคำนวณ Imputation เสมอ และต้องสร้างคอลัมน์ Flag เช่น <code>income_imputed = 1</code> เพื่อ Traceability</span>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {/* MODULE 03: Feature Engineering Visual Blueprint */}
              {mod.id === 'module-03-feature-engineering' && (
                <div class="space-y-6">
                  <!-- Slide: Spread Shows What the Center Leaves Out -->
                  <div class="slide-card rounded-2xl border border-slate-200/80 bg-white shadow-2xs overflow-hidden transition-all hover:border-slate-300">
                    <div class="bg-slate-50/90 px-4 py-2.5 border-b border-slate-200/70 flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
                      <div class="flex items-center gap-2 font-bold text-slate-900">
                        <span class="w-2 h-2 rounded-full bg-[#66A1EE]"></span>
                        <span>การวัดการกระจายของข้อมูล (Spread Shows What Center Leaves Out)</span>
                      </div>
                      <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-md bg-white border border-slate-200 text-slate-600 font-semibold text-[11px]">Lect 05 p07</span>
                        <span class="text-[#2563EB] text-[11px] font-semibold cursor-pointer">🔍 ขยายภาพ</span>
                      </div>
                    </div>
                    <div class="p-2 sm:p-4 bg-slate-900/[0.02] flex justify-center cursor-zoom-in">
                      <img
                        src="/slides/L05_p07.png"
                        alt="Spread Shows What the Center Leaves Out"
                        class="slide-img w-full max-w-3xl h-auto rounded-xl border border-slate-200/70 shadow-xs hover:brightness-[1.01] transition-all object-contain"
                        loading="lazy"
                        data-slide-src="/slides/L05_p07.png"
                        data-slide-title="การวัดการกระจายของข้อมูล (Spread Shows What Center Leaves Out)"
                        data-slide-ref="Lect 05 p07"
                      />
                    </div>
                    <div class="px-4 py-3 bg-white border-t border-slate-100 space-y-1.5 text-xs">
                      <div class="flex items-start gap-2 text-slate-700">
                        <span class="font-bold text-slate-900 shrink-0 font-mono">★ สาระสำคัญ:</span>
                        <span class="leading-relaxed"><strong>ค่ากลางเท่ากัน ≠ ข้อมูลเหมือนกัน:</strong> Variance มีหน่วยยกกำลังสอง ส่วน SD มีหน่วยเดียวกับข้อมูลเดิม มอง Spread ผ่าน Range, IQR และ SD เพื่อตรวจความแปรปรวน</span>
                      </div>
                      <div class="flex items-start gap-2 text-rose-700 bg-rose-50/50 p-2.5 rounded-xl border border-rose-100 font-medium">
                        <span class="font-bold text-rose-800 shrink-0 font-mono">⚠️ กับดัก Data Leakage & Z-Score:</span>
                        <span class="leading-relaxed"><strong>Fit เฉพาะบน Training Set</strong> แล้วนำ min, max, μ, σ ไป Transform บน Val และ Test เท่านั้น! และ <strong>Z-Score ไม่เปลี่ยนรูปทรงความเบ้ (Shape)</strong> หากข้อมูลเดิมเบ้ขวา ทำ Z-Score แล้วก็ยังคงเบ้ขวาเหมือนเดิม</span>
                      </div>
                    </div>
                  </div>
                </div>
              )}

              {/* MODULE 04: EDA & Outliers (The real PDF slides requested by user) */}
              {mod.id === 'module-04-eda-outliers' && (
                <div class="space-y-6">
                  <!-- Slide 1: Boxplot & IQR Rule -->
                  <div class="slide-card rounded-2xl border border-slate-200/80 bg-white shadow-2xs overflow-hidden transition-all hover:border-slate-300">
                    <div class="bg-slate-50/90 px-4 py-2.5 border-b border-slate-200/70 flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
                      <div class="flex items-center gap-2 font-bold text-slate-900">
                        <span class="w-2 h-2 rounded-full bg-[#66A1EE]"></span>
                        <span>โครงสร้าง Boxplot & กฎ 1.5 × IQR ของ Tukey (Fences & Whiskers)</span>
                      </div>
                      <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-md bg-white border border-slate-200 text-slate-600 font-semibold text-[11px]">Lect 05 p17</span>
                        <span class="text-[#2563EB] text-[11px] font-semibold cursor-pointer">🔍 ขยายภาพ</span>
                      </div>
                    </div>
                    <div class="p-2 sm:p-4 bg-slate-900/[0.02] flex justify-center cursor-zoom-in">
                      <img
                        src="/slides/L05_p17.png"
                        alt="Boxplots and IQR Flag Potential Outliers"
                        class="slide-img w-full max-w-3xl h-auto rounded-xl border border-slate-200/70 shadow-xs hover:brightness-[1.01] transition-all object-contain"
                        loading="lazy"
                        data-slide-src="/slides/L05_p17.png"
                        data-slide-title="โครงสร้าง Boxplot & กฎ 1.5 × IQR ของ Tukey (Fences & Whiskers)"
                        data-slide-ref="Lect 05 p17"
                      />
                    </div>
                    <div class="px-4 py-3 bg-white border-t border-slate-100 space-y-2 text-xs">
                      <div class="flex items-start gap-2 text-slate-700">
                        <span class="font-bold text-slate-900 shrink-0 font-mono">★ สาระสำคัญ:</span>
                        <span class="leading-relaxed"><strong>Boxplot + IQR = Screening ไม่ใช่ Verdict:</strong> ค่า Lower Fence = Q1 − 1.5×IQR, Upper Fence = Q3 + 1.5×IQR และจุดที่อยู่นอกรั้วคือ Potential Outlier ที่ควรตรวจสอบต่อ แต่ไม่ได้แปลว่าเป็น Error</span>
                      </div>
                      <div class="flex items-start gap-2 text-rose-700 bg-rose-50/50 p-2.5 rounded-xl border border-rose-100 font-medium">
                        <span class="font-bold text-rose-800 shrink-0 font-mono">⚠️ จุดหลอกข้อสอบยอดฮิต:</span>
                        <span class="leading-relaxed"><strong>Fence เป็นเกณฑ์ ส่วน Whisker สิ้นสุดที่ค่าจริงสุดท้ายซึ่งยังอยู่ภายใน Fence!</strong> เส้นหนวดไม่ได้ลากไปจรดขอบ Fence (เช่น หาก Fence = 120/130 แต่ข้อมูลจริงสูงสุดก่อนหลุดรั้วคือ 115 เส้น Whisker จะหยุดที่ 115 เสมอ ห้ามลากชนรั้ว!)</span>
                      </div>
                    </div>
                  </div>

                  <!-- Slide 2: Outlier Action Framework -->
                  <div class="slide-card rounded-2xl border border-slate-200/80 bg-white shadow-2xs overflow-hidden transition-all hover:border-slate-300">
                    <div class="bg-slate-50/90 px-4 py-2.5 border-b border-slate-200/70 flex flex-wrap items-center justify-between gap-2 text-xs font-mono">
                      <div class="flex items-center gap-2 font-bold text-slate-900">
                        <span class="w-2 h-2 rounded-full bg-[#66A1EE]"></span>
                        <span>การจัดการ Outlier: สืบค้นก่อนตัดสินใจ (Investigate Before Acting)</span>
                      </div>
                      <div class="flex items-center gap-2">
                        <span class="px-2.5 py-0.5 rounded-md bg-white border border-slate-200 text-slate-600 font-semibold text-[11px]">Lect 05 p18</span>
                        <span class="text-[#2563EB] text-[11px] font-semibold cursor-pointer">🔍 ขยายภาพ</span>
                      </div>
                    </div>
                    <div class="p-2 sm:p-4 bg-slate-900/[0.02] flex justify-center cursor-zoom-in">
                      <img
                        src="/slides/L05_p18.png"
                        alt="Investigate an Outlier Before Acting"
                        class="slide-img w-full max-w-3xl h-auto rounded-xl border border-slate-200/70 shadow-xs hover:brightness-[1.01] transition-all object-contain"
                        loading="lazy"
