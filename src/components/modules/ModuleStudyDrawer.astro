<!-- Slide Lightbox Modal for Full-Resolution Viewing -->
<div
  id="slide-lightbox-modal"
  class="fixed inset-0 z-60 hidden bg-slate-950/85 backdrop-blur-sm p-3 sm:p-6 flex flex-col items-center justify-center"
  role="dialog"
  aria-modal="true"
  aria-label="ขยายภาพสไลด์บรรยาย"
>
  <div class="w-full max-w-5xl max-h-[92vh] flex flex-col bg-white rounded-2xl overflow-hidden shadow-2xl border border-slate-200">
    <div class="px-4 py-3 bg-slate-900 text-white flex items-center justify-between font-mono text-xs">
      <div class="flex items-center gap-2 truncate">
        <span id="lightbox-ref" class="px-2 py-0.5 rounded bg-slate-800 text-[#66A1EE] font-bold"></span>
        <span id="lightbox-title" class="font-bold text-white truncate"></span>
      </div>
      <button
        id="lightbox-close-btn"
        type="button"
        class="px-3 py-1 bg-slate-800 hover:bg-rose-600 text-white rounded-lg font-bold text-xs cursor-pointer transition-colors"
      >
        ✕ ปิด [ESC]
      </button>
    </div>
    <div class="p-2 sm:p-4 overflow-auto flex items-center justify-center bg-slate-950/5">
      <img
        id="lightbox-img"
        src=""
        alt="Expanded Slide"
        class="max-w-full max-h-[78vh] object-contain rounded-lg shadow-md border border-slate-200/80"
      />
    </div>
  </div>
</div>

<script>
  // Slide Lightbox Modal Interactivity
  const lightbox = document.getElementById('slide-lightbox-modal');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxTitle = document.getElementById('lightbox-title');
  const lightboxRef = document.getElementById('lightbox-ref');
  const lightboxClose = document.getElementById('lightbox-close-btn');

  const openLightbox = (src: string, title?: string, ref?: string) => {
    if (!lightbox || !lightboxImg) return;
    lightboxImg.src = src;
    if (lightboxTitle) lightboxTitle.textContent = title || 'สไลด์บรรยายจริง';
    if (lightboxRef) lightboxRef.textContent = ref || '';
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
  };

  const closeLightbox = () => {
    if (!lightbox) return;
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    if (lightboxImg) lightboxImg.src = '';
  };

  if (lightboxClose) {
    lightboxClose.addEventListener('click', closeLightbox);
  }

  if (lightbox) {
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && lightbox && !lightbox.classList.contains('hidden')) {
      e.stopPropagation();
      closeLightbox();
    }
  });

  // Delegate click for any .slide-img or slide card trigger
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;

    if (target.matches('.slide-img')) {
      const src = target.getAttribute('data-slide-src') || (target as HTMLImageElement).src;
      const title = target.getAttribute('data-slide-title') || '';
      const ref = target.getAttribute('data-slide-ref') || '';
      if (src) openLightbox(src, title, ref);
      return;
    }

    const card = target.closest('.slide-card');
    if (card && (target.closest('[data-slide-src]') || target.textContent?.includes('ขยายภาพ') || target.closest('button'))) {
      const img = card.querySelector('.slide-img') as HTMLImageElement | null;
      if (img) {
        const src = img.getAttribute('data-slide-src') || img.src;
        const title = img.getAttribute('data-slide-title') || '';
        const ref = img.getAttribute('data-slide-ref') || '';
        if (src) openLightbox(src, title, ref);
      }
    }
  });
</script>
