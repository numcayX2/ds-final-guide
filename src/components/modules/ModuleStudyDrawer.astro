                    <div class="p-3 bg-[#A3E635]/25 border border-[#171719]">
                      <div class="font-bold text-[#171719]">✅ กฎ Fit เฉพาะบน Training Set</div>
                      <p class="mt-1 text-[11px]">คำนวณค่า min, max, μ, σ จาก <strong>Training Set เท่านั้น</strong> แล้วนำค่าพารามิเตอร์เดิมนั้นไปแปลง (Transform) บน Validation และ Test Set</p>
                    </div>
                    <div class="p-3 bg-white border border-[#171719]">
                      <div class="font-bold text-[#E11D48]">⚠️ Z-Score ไม่เปลี่ยนรูปทรงความเบ้ (Shape)</div>
                      <p class="mt-1 text-[11px]">Z-Score ปรับเพียง Mean = 0, SD = 1 แต่ถ้าข้อมูลเดิมเบ้ขวา หลังทำ Z-Score ก็ยังคงเบ้ขวาเหมือนเดิม (แก้ความเบ้ต้องใช้ Log Transform)</p>
                    </div>
                  </div>
                </div>
              )}
            </div>

            <!-- ========================================================= -->
            <!-- ALL EXAM TRAPS (ครบทุกจุดหลอกในบทเรียน พร้อมเทียบ ผิด vs ถูก) -->
            <!-- ========================================================= -->
            <div class="space-y-3">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 bg-[#E11D48] text-white font-mono text-xs font-bold">
                  EXAM TRAPS ({mod.examTraps.length} จุดต้องระวัง)
                </span>
                <h3 class="font-['Space_Grotesk'] font-black text-base sm:text-lg text-[#171719]">
                  กับดักข้อสอบอาจารย์ & วิธีคิดที่ถูกต้องตามสไลด์
                </h3>
              </div>

              <div class="grid grid-cols-1 gap-4">
                {mod.examTraps.map((trap, tIdx) => (
                  <div class="border-2 border-[#171719] bg-white shadow-[3px_3px_0px_#E11D48] overflow-hidden">
                    <div class="bg-[#171719] text-white px-4 py-2 flex flex-wrap justify-between items-center gap-2 font-mono text-xs">
                      <span class="font-bold text-[#A3E635]">
                        ⚠️ กับดักจุดที่ {tIdx + 1}: {trap.trapTitle}
                      </span>
                      <span class="px-2 py-0.5 bg-[#222226] border border-gray-600 text-gray-200 text-[11px]">
                        อ้างอิง: {trap.slideRef}
                      </span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 divide-y md:divide-y-0 md:divide-x divide-[#171719]">
                      <div class="p-4 bg-[#E11D48]/5">
                        <div class="text-xs font-mono font-bold text-[#BE123C] mb-1">
                          ❌ สิ่งที่โจทย์หลอก / ความเข้าใจผิดที่พบบ่อย:
                        </div>
                        <p class="text-xs sm:text-sm text-gray-800 leading-relaxed">
                          {trap.trapDescription}
                        </p>
                      </div>
                      <div class="p-4 bg-[#A3E635]/15">
                        <div class="text-xs font-mono font-bold text-[#171719] mb-1">
                          ✅ หลักการที่ถูกต้องตามสไลด์อาจารย์:
                        </div>
                        <p class="text-xs sm:text-sm text-[#171719] font-semibold leading-relaxed">
                          {trap.correctApproach}
                        </p>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- ========================================================= -->
            <!-- ULTRA-DETAILED SECTIONS & TABLES -->
            <!-- ========================================================= -->
            <div class="space-y-6">
              {mod.sections.map((sec) => (
                <div class="border-2 border-[#171719] bg-white p-4 sm:p-6 shadow-[4px_4px_0px_#171719]">
                  <h4 class="font-['Space_Grotesk'] font-black text-base sm:text-lg text-[#171719] border-b-2 border-[#171719] pb-2 mb-2">
                    {sec.title}
                  </h4>
                  <p class="text-xs sm:text-sm font-mono text-gray-600 mb-4">
                    {sec.conceptSummary}
                  </p>

                  {sec.tableData && (
                    <div class="overflow-x-auto mb-4">
                      <table class="w-full text-left text-xs font-mono border-collapse border-2 border-[#171719]">
                        <thead>
                          <tr class="bg-[#171719] text-[#A3E635]">
                            {sec.tableData.headers.map((h) => (
                              <th class="p-2.5 border border-[#171719] font-bold">{h}</th>
                            ))}
                          </tr>
                        </thead>
                        <tbody class="divide-y divide-[#171719]/30">
                          {sec.tableData.rows.map((row, rIdx) => (
                            <tr class={rIdx % 2 === 0 ? 'bg-white' : 'bg-[#F4F1EA]/60'}>
                              {row.map((cell, cIdx) => (
                                <td class={`p-2.5 border border-[#171719]/30 leading-relaxed ${cIdx === 0 ? 'font-bold text-[#171719]' : 'text-gray-800'}`}>
                                  {cell}
                                </td>
                              ))}
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}

                  <ul class="space-y-2">
                    {sec.keyPoints.map((pt) => (
                      <li class="flex items-start gap-2.5 text-xs sm:text-sm text-[#171719] leading-relaxed bg-[#F4F1EA]/70 p-2.5 border-l-4 border-[#171719]">
                        <span class="font-mono font-bold text-[#171719] shrink-0">▪</span>
                        <span>{pt}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>

            <!-- Modal Footer Navigation -->
            <div class="pt-4 border-t-2 border-[#171719] flex flex-wrap justify-between items-center gap-3 font-mono text-xs">
              <div class="flex items-center gap-2">
                {prevMod && (
                  <button
                    type="button"
                    data-switch-module={prevMod.id}
                    class="px-3.5 py-2 bg-white hover:bg-[#EAE6DC] text-[#171719] font-bold border-2 border-[#171719] shadow-[2px_2px_0px_#171719] cursor-pointer"
                  >
                    ← บทที่ {prevMod.moduleNumber}
                  </button>
                )}
                {nextMod && (
                  <button
                    type="button"
                    data-switch-module={nextMod.id}
                    class="px-3.5 py-2 bg-[#171719] hover:bg-[#222226] text-[#A3E635] font-bold border-2 border-[#171719] shadow-[2px_2px_0px_#171719] cursor-pointer"
                  >
                    บทที่ {nextMod.moduleNumber}: {nextMod.title.slice(0, 22)}... →
                  </button>
                )}
              </div>

              <button
                type="button"
                data-close-modal
                class="px-4 py-2 bg-white hover:bg-gray-100 text-[#171719] font-bold border-2 border-[#171719] cursor-pointer"
              >
                กลับไปยังหน้ารวมบทเรียน
              </button>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</div>
