---
import type { StudyModule } from '../../types/study';

interface Props {
  modules: StudyModule[];
}

const { modules } = Astro.props;
---

<!-- Ultra-Detailed Visual Study Drawer / Modal -->
<div
  id="module-study-modal"
  class="fixed inset-0 z-50 hidden bg-[#171719]/80 backdrop-blur-[2px] overflow-y-auto p-2 sm:p-4 md:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-module-title"
  data-lenis-prevent
>
  <div class="max-w-5xl mx-auto my-2 sm:my-4 border-2 border-[#171719] bg-[#F4F1EA] shadow-[8px_8px_0px_#171719] overflow-hidden">
    {modules.map((mod, idx) => {
      const prevMod = idx > 0 ? modules[idx - 1] : null;
      const nextMod = idx < modules.length - 1 ? modules[idx + 1] : null;

      return (
        <div
          class="module-detail-pane hidden"
          data-module-pane={mod.id}
        >
          <!-- Sticky Top Bar -->
          <div class="sticky top-0 z-30 bg-[#171719] text-[#F4F1EA] px-4 sm:px-6 py-3.5 border-b-2 border-[#171719] flex flex-wrap justify-between items-center gap-3">
            <div class="flex items-center gap-2.5 min-w-0">
              <span class="w-8 h-8 bg-[#A3E635] text-[#171719] font-['Space_Grotesk'] font-black text-sm flex items-center justify-center border border-[#171719] shrink-0">
                {mod.moduleNumber}
              </span>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-2 text-[11px] font-mono text-gray-300">
                  <span class="text-[#A3E635] font-bold">{mod.lectureCode}</span>
                  <span>•</span>
                  <span>เวลาทบทวน ~{mod.timeEstimateMinutes} นาที</span>
                  {mod.isFinalFocus && (
                    <span class="bg-[#E11D48] text-white px-1.5 py-0.2 font-bold text-[10px]">
                      ออกสอบเน้นๆ (FINAL FOCUS)
                    </span>
                  )}
                </div>
                <h2 id="modal-module-title" class="font-['Space_Grotesk'] font-bold text-base sm:text-xl text-white truncate">
                  {mod.title}
                </h2>
              </div>
            </div>

            <div class="flex items-center gap-2 shrink-0">
              <!-- Synced Read Status Toggle Button -->
              <button
                type="button"
                class="module-mark-btn inline-flex items-center gap-1.5 px-3 py-1.5 border border-[#F4F1EA]/40 bg-[#222226] text-[#F4F1EA] hover:border-[#A3E635] text-xs font-mono font-bold transition-all cursor-pointer"
                data-mod-id={mod.id}
              >
                <span class="mark-icon w-3.5 h-3.5 border border-current flex items-center justify-center text-[10px]"></span>
                <span class="mark-label">ทำเครื่องหมายว่าทบทวนแล้ว</span>
              </button>

              <!-- Close Button -->
              <button
                type="button"
                data-close-modal
                class="px-3 py-1.5 bg-[#E11D48] hover:bg-[#BE123C] text-white font-mono font-bold text-xs border border-[#171719] cursor-pointer transition-colors"
                aria-label="ปิดหน้าต่างสรุปบทเรียน (ESC)"
              >
                ✕ ปิด [ESC]
              </button>
            </div>
          </div>

          <!-- Modal Body Content -->
          <div class="p-4 sm:p-6 md:p-8 space-y-8">
            <!-- Quick Overview Banner -->
            <div class="bg-white border-2 border-[#171719] p-4 sm:p-5 shadow-[4px_4px_0px_#171719]">
              <div class="text-[11px] font-mono font-bold uppercase text-gray-500 mb-1">
                OVERVIEW • แก่นสำคัญของบทเรียน ({mod.titleEn})
              </div>
              <p class="text-sm sm:text-base text-[#171719] font-medium leading-relaxed">
                {mod.quickSummary}
              </p>
              {mod.coreFormulas.length > 0 && (
                <div class="mt-3 pt-3 border-t border-[#171719]/20 flex flex-wrap items-center gap-2">
                  <span class="text-xs font-mono font-bold text-[#171719]">🔢 สูตรคำนวณที่เกี่ยวข้อง:</span>
                  {mod.coreFormulas.map((fId) => (
                    <a
                      href={`/formulas#${fId}`}
                      class="px-2.5 py-1 bg-[#A3E635] hover:bg-[#84CC16] text-[#171719] border border-[#171719] font-mono text-xs font-bold shadow-[2px_2px_0px_#171719] transition-all"
                    >
                      เปิดแอนิเมชัน {fId} →
                    </a>
                  ))}
                </div>
              )}
            </div>

            <!-- ========================================================= -->
            <!-- VISUAL MEMORY BLUEPRINTS (เฉพาะแต่ละบทเรียน เพื่อการจำเข้าห้องสอบ) -->
            <!-- ========================================================= -->
            <div class="border-2 border-[#171719] bg-white p-4 sm:p-6 shadow-[4px_4px_0px_#171719]">
              <div class="flex flex-wrap items-center justify-between gap-2 border-b-2 border-[#171719] pb-3 mb-5">
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 bg-[#171719] text-[#A3E635] font-mono text-xs font-bold">
                    VISUAL MEMORY BLUEPRINT
                  </span>
                  <h3 class="font-['Space_Grotesk'] font-black text-base sm:text-lg text-[#171719]">
                    แผนภาพจำภาพรวมและจุดออกสอบ (Visual Schematic)
                  </h3>
                </div>
                <span class="text-[11px] font-mono text-gray-500">อ้างอิงตรงตามสไลด์ {mod.lectureCode}</span>
              </div>

              {/* MODULE 04 VISUAL: Boxplot & Tukey's Fences + EDA Role */}
              {mod.id === 'module-04-eda-outliers' && (
                <div class="space-y-6">
                  <!-- Boxplot & Whisker Rule SVG Diagram -->
                  <div class="bg-[#F4F1EA] border border-[#171719] p-4">
                    <div class="text-xs font-mono font-bold text-[#171719] mb-3 flex flex-wrap justify-between gap-2">
                      <span>📐 แผนภาพโครงสร้าง Boxplot & กฎเหล็กเส้นหนวดของ Tukey (Lect 05 p17–18)</span>
                      <span class="text-[#E11D48]">★ จุดหลอกข้อสอบ: เส้นหนวดหยุดที่ข้อมูลจริงในรั้ว ไม่ได้ลากไปชน Fence!</span>
                    </div>
                    <div class="overflow-x-auto">
                      <svg viewBox="0 0 760 190" class="w-full min-w-[600px] h-auto bg-white border border-[#171719] p-2">
                        <!-- Number line axis -->
                        <line x1="40" y1="150" x2="720" y2="150" stroke="#171719" stroke-width="2" />
                        <!-- Lower Fence = 40 -->
                        <line x1="110" y1="35" x2="110" y2="155" stroke="#E11D48" stroke-width="2" stroke-dasharray="5,5" />
                        <text x="110" y="25" text-anchor="middle" font-family="monospace" font-size="11" font-weight="bold" fill="#E11D48">Lower Fence = 40</text>
                        <text x="110" y="172" text-anchor="middle" font-family="monospace" font-size="10" fill="#666">Q1 − 1.5(IQR)</text>

                        <!-- Min Actual Data inside fence = 65 -->
                        <line x1="200" y1="75" x2="200" y2="115" stroke="#171719" stroke-width="3" />
                        <line x1="200" y1="95" x2="250" y2="95" stroke="#171719" stroke-width="2.5" />
                        <circle cx="200" cy="95" r="4" fill="#171719" />
                        <text x="200" y="65" text-anchor="middle" font-family="monospace" font-size="11" font-weight="bold" fill="#171719">Min ในรั้ว (65)</text>

                        <!-- IQR Box [Q1=70 to Q3=90] -->
                        <rect x="250" y="65" width="180" height="60" fill="#A3E635" fill-opacity="0.35" stroke="#171719" stroke-width="2.5" />
                        <!-- Median = 82.5 -->
                        <line x1="355" y1="65" x2="355" y2="125" stroke="#171719" stroke-width="3.5" />
                        <text x="250" y="55" text-anchor="middle" font-family="monospace" font-size="11" font-weight="bold" fill="#171719">Q1 = 70</text>
                        <text x="355" y="55" text-anchor="middle" font-family="monospace" font-size="11" font-weight="bold" fill="#2563EB">Median = 82.5</text>
                        <text x="430" y="55" text-anchor="middle" font-family="monospace" font-size="11" font-weight="bold" fill="#171719">Q3 = 90</text>
                        <text x="340" y="100" text-anchor="middle" font-family="monospace" font-size="12" font-weight="bold" fill="#171719">IQR = 90 − 70 = 20</text>

                        <!-- Right Whisker stops at 115 (Last actual data point inside fence) -->
                        <line x1="430" y1="95" x2="520" y2="95" stroke="#171719" stroke-width="2.5" />
                        <line x1="520" y1="75" x2="520" y2="115" stroke="#2563EB" stroke-width="3.5" />
                        <circle cx="520" cy="95" r="4.5" fill="#2563EB" />
                        <text x="520" y="62" text-anchor="middle" font-family="monospace" font-size="11" font-weight="bold" fill="#2563EB">ปลาย Whisker (115)</text>
                        <text x="520" y="138" text-anchor="middle" font-family="monospace" font-size="10" font-weight="bold" fill="#2563EB">หยุดที่ข้อมูลจริงตัวสุดท้าย!</text>

                        <!-- Gap between Whisker end and Upper Fence -->
                        <text x="565" y="98" text-anchor="middle" font-family="monospace" font-size="10" fill="#E11D48">← ห้ามลากชนรั้ว!</text>

                        <!-- Upper Fence = 120 / 130 -->
                        <line x1="610" y1="35" x2="610" y2="155" stroke="#E11D48" stroke-width="2" stroke-dasharray="5,5" />
                        <text x="610" y="25" text-anchor="middle" font-family="monospace" font-size="11" font-weight="bold" fill="#E11D48">Upper Fence (120 / 130)</text>
                        <text x="610" y="172" text-anchor="middle" font-family="monospace" font-size="10" fill="#666">Q3 + 1.5(IQR)</text>

                        <!-- Potential Outlier = 140 -->
                        <circle cx="685" cy="95" r="7" fill="#E11D48" stroke="#171719" stroke-width="2" />
                        <text x="685" y="70" text-anchor="middle" font-family="monospace" font-size="11" font-weight="bold" fill="#E11D48">จุด 140 (Outlier)</text>
                        <text x="685" y="135" text-anchor="middle" font-family="monospace" font-size="10" font-weight="bold" fill="#BE123C">Potential Outlier != Error</text>
                      </svg>
                    </div>
                  </div>

                  <!-- EDA Role & Confounder Visual Grid -->
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs">
                    <div class="p-4 border border-[#171719] bg-[#A3E635]/15">
                      <div class="font-bold text-[#171719] mb-2">✅ บทบาทที่แท้จริงของ EDA (Lect 05 p04)</div>
                      <div class="flex items-center gap-2 bg-white p-2.5 border border-[#171719]">
                        <span class="px-2 py-1 bg-[#171719] text-[#A3E635] font-bold">EDA</span>
                        <span>→</span>
                        <span class="font-bold text-[#171719]">"Informs modeling decisions"</span>
                      </div>
                      <p class="text-[11px] text-gray-700 mt-2">
                        ชี้แนะแนวทางให้ Data Scientist เห็นความเบ้, Outlier และความสัมพันธ์ แต่ <strong>"ไม่ได้เลือกอัลกอริทึมให้อัตโนมัติ"</strong>
                      </p>
                    </div>
                    <div class="p-4 border border-[#171719] bg-[#E11D48]/10">
                      <div class="font-bold text-[#BE123C] mb-2">⚠️ กับดักตัวแปรกวน (Confounding Variable)</div>
                      <div class="bg-white p-2.5 border border-[#171719] text-center">
                        <span class="font-bold text-[#E11D48]">[อุณหภูมิฤดูร้อน (Confounder)]</span>
                        <div class="text-[11px] mt-1">↙ ส่งผลทั้งคู่ ↘</div>
                        <div class="flex justify-around font-bold mt-1">
                          <span>ยอดขายไอศกรีม ↑</span>
                          <span>≠</span>
                          <span>อัตราจมน้ำ ↑</span>
                        </div>
                      </div>
                      <p class="text-[11px] text-gray-700 mt-2">
                        <strong>Correlation != Causation:</strong> มีสหสัมพันธ์กันไม่ได้แปลว่าเป็นต้นเหตุของกันและกัน
                      </p>
                    </div>
                  </div>
                </div>
              )}

              {/* MODULE 05 VISUAL: 3-Way Partitioning & 4 Candidate Models */}
              {mod.id === 'module-05-modeling-framework' && (
                <div class="space-y-6">
                  <!-- 3-Way Partitioning Visual Bar -->
                  <div class="bg-[#F4F1EA] border border-[#171719] p-4">
                    <div class="text-xs font-mono font-bold text-[#171719] mb-3">
                      🛡️ แผนภาพการแบ่งข้อมูล 3 ส่วน & กฎเหล็ก Protect the Test Set (Lect 07 p07, p32)
                    </div>
                    <div class="grid grid-cols-12 border-2 border-[#171719] text-xs font-mono overflow-hidden">
                      <div class="col-span-12 md:col-span-7 bg-[#A3E635] p-3.5 border-b-2 md:border-b-0 md:border-r-2 border-[#171719]">
                        <div class="font-black text-sm text-[#171719]">1. TRAINING SET (60% – 70%)</div>
                        <div class="text-[11px] text-[#171719] mt-1">• ใช้สอนโมเดล (Fit Parameters & เรียนรู้กฎ)</div>
                        <div class="text-[11px] font-bold text-[#171719] mt-1">🔄 ทำงานคู่กับ Validation ในลูปปรับจูน</div>
                      </div>
                      <div class="col-span-12 md:col-span-3 bg-[#F59E0B]/40 p-3.5 border-b-2 md:border-b-0 md:border-r-4 border-[#171719]">
                        <div class="font-black text-sm text-[#171719]">2. VALIDATION (15–20%)</div>
                        <div class="text-[11px] text-[#171719] mt-1">• จูน Hyperparameter (เช่น max_depth)</div>
                        <div class="text-[11px] font-bold text-[#171719] mt-1">• คัดเลือกผู้ชนะจาก 4 Candidate Models</div>
                      </div>
                      <div class="col-span-12 md:col-span-2 bg-[#E11D48] text-white p-3.5 flex flex-col justify-between">
                        <div class="font-black text-sm">🔒 3. TEST SET (15–20%)</div>
                        <div class="text-[10px] mt-1 leading-snug">
                          <strong>PROTECTED EVIDENCE!</strong> ห้ามแตะต้องตอนจูน ใช้ประเมินครั้งเดียวตอนจบเท่านั้น
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- 4 Candidate Models Visual Cards -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 font-mono text-xs">
                    <div class="p-3.5 border-2 border-[#171719] bg-white">
                      <div class="px-2 py-0.5 bg-[#171719] text-[#A3E635] font-bold inline-block text-[10px] mb-2">MODEL 01</div>
                      <div class="font-bold text-sm text-[#171719]">🌳 Decision Tree</div>
                      <p class="text-[11px] text-gray-600 mt-1">แตกกิ่ง If-Else ด้วย Gini Impurity อ่านกฎเข้าใจง่าย (White-box) ไม่ต้องทำ Scaling</p>
                    </div>
                    <div class="p-3.5 border-2 border-[#171719] bg-white">
                      <div class="px-2 py-0.5 bg-[#171719] text-[#A3E635] font-bold inline-block text-[10px] mb-2">MODEL 02</div>
                      <div class="font-bold text-sm text-[#171719]">📍 5-NN (Nearest Neighbors)</div>
                      <p class="text-[11px] text-gray-600 mt-1">โหวตจากเพื่อนบ้านใกล้สุด 5 จุด <strong>ต้องทำ Feature Scaling เสมอ</strong> เพราะใช้ระยะทาง</p>
                    </div>
                    <div class="p-3.5 border-2 border-[#171719] bg-white">
                      <div class="px-2 py-0.5 bg-[#171719] text-[#A3E635] font-bold inline-block text-[10px] mb-2">MODEL 03</div>
                      <div class="font-bold text-sm text-[#171719]">🎲 Naive Bayes</div>
                      <p class="text-[11px] text-gray-600 mt-1">คำนวณความน่าจะเป็น Bayes P(Y|X) สมมติให้ทุกตัวแปรเป็นอิสระต่อกัน</p>
                    </div>
                    <div class="p-3.5 border-2 border-[#171719] bg-white">
                      <div class="px-2 py-0.5 bg-[#171719] text-[#A3E635] font-bold inline-block text-[10px] mb-2">MODEL 04</div>
                      <div class="font-bold text-sm text-[#171719]">🧠 Neural Network</div>
                      <p class="text-[11px] text-gray-600 mt-1">โครงข่ายประสาทเทียมหลายชั้น จับ Non-linear ซับซ้อนได้สูง แต่เป็น Black-box</p>
                    </div>
                  </div>
                </div>
              )}

              {/* MODULE 06 VISUAL: Candidate A vs B Gini Battle & Tree Depth Ladder */}
              {mod.id === 'module-06-decision-tree' && (
                <div class="space-y-6">
                  <!-- Candidate A vs B Visual Tree Battle -->
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 font-mono text-xs">
                    <div class="border-2 border-[#171719] bg-[#A3E635]/20 p-4 relative">
                      <span class="absolute top-3 right-3 px-2 py-0.5 bg-[#171719] text-[#A3E635] font-bold text-[10px]">
                        🏆 WINNER (เลือกกิ่งนี้!)
                      </span>
                      <div class="font-black text-sm text-[#171719] mb-2">CANDIDATE SPLIT A (Lect 07 p11)</div>
                      <div class="bg-white border border-[#171719] p-2.5 text-center mb-2">
                        Parent Node (N=12): <strong>[6 Play, 6 No]</strong> → Gini = <strong>0.500</strong>
                      </div>
                      <div class="grid grid-cols-2 gap-2 text-center mb-3">
                        <div class="bg-white border border-[#171719] p-2">
                          <div class="font-bold">Left (n=6): [5, 1]</div>
                          <div class="text-[#2563EB] font-bold">Gini = 0.278</div>
                        </div>
                        <div class="bg-white border border-[#171719] p-2">
                          <div class="font-bold">Right (n=6): [1, 5]</div>
                          <div class="text-[#2563EB] font-bold">Gini = 0.278</div>
                        </div>
                      </div>
                      <div class="bg-[#171719] text-white p-2.5 flex justify-between items-center">
                        <span>Gini_split = <strong>0.278</strong> (ต่ำสุด)</span>
                        <span class="text-[#A3E635] font-black">Gini Gain = 0.222 (สูงสุด!)</span>
                      </div>
                    </div>

                    <div class="border-2 border-[#171719] bg-[#F4F1EA] p-4 relative opacity-90">
                      <span class="absolute top-3 right-3 px-2 py-0.5 bg-gray-300 text-[#171719] font-bold text-[10px]">
                        ❌ แพ้ (คละกันมากกว่า)
                      </span>
                      <div class="font-black text-sm text-[#171719] mb-2">CANDIDATE SPLIT B (Lect 07 p12)</div>
                      <div class="bg-white border border-[#171719] p-2.5 text-center mb-2">
                        Parent Node (N=12): <strong>[6 Play, 6 No]</strong> → Gini = <strong>0.500</strong>
                      </div>
                      <div class="grid grid-cols-2 gap-2 text-center mb-3">
                        <div class="bg-white border border-[#171719] p-2">
                          <div class="font-bold">Left (n=6): [4, 2]</div>
                          <div class="text-[#E11D48] font-bold">Gini = 0.444</div>
                        </div>
                        <div class="bg-white border border-[#171719] p-2">
                          <div class="font-bold">Right (n=6): [2, 4]</div>
                          <div class="text-[#E11D48] font-bold">Gini = 0.444</div>
                        </div>
                      </div>
                      <div class="bg-gray-200 text-[#171719] border border-[#171719] p-2.5 flex justify-between items-center">
                        <span>Gini_split = <strong>0.444</strong> (สูงกว่า)</span>
                        <span class="text-[#E11D48] font-bold">Gini Gain = 0.056 (ต่ำ)</span>
                      </div>
                    </div>
                  </div>

                  <!-- Tree Complexity Visual Ladder -->
                  <div class="bg-[#F4F1EA] border border-[#171719] p-4 font-mono text-xs">
                    <div class="font-bold text-[#171719] mb-3">
                      📈 แผนภาพบันไดความลึกต้นไม้ (Tree Complexity vs Validation Performance — Lect 07 p19, p31)
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-2.5">
                      <div class="p-3 bg-white border border-[#171719]">
                        <div class="text-[10px] font-bold text-gray-500">1. SHALLOW (depth = 1)</div>
                        <div class="font-black text-[#E11D48] mt-1">Underfitting</div>
                        <div class="text-[11px] mt-1">High Bias / Low Variance</div>
                        <div class="mt-2 text-[11px] bg-gray-100 p-1">ตื้นเกินไป จับ Pattern ไม่ได้</div>
                      </div>
                      <div class="p-3 bg-[#A3E635]/30 border-2 border-[#171719] shadow-[2px_2px_0px_#171719]">
                        <div class="text-[10px] font-black text-[#171719]">2. MODERATE (depth = 3) ★</div>
                        <div class="font-black text-[#171719] mt-1">Appropriate Fit!</div>
                        <div class="text-[11px] mt-1">Low Bias / Low Variance</div>
                        <div class="mt-2 text-[11px] bg-[#171719] text-[#A3E635] font-bold p-1">Validation สูงสุด (เลือก!)</div>
                      </div>
                      <div class="p-3 bg-white border border-[#171719]">
                        <div class="text-[10px] font-bold text-gray-500">3. DEEP (depth ≥ 6)</div>
                        <div class="font-black text-[#F59E0B] mt-1">Overfitting</div>
                        <div class="text-[11px] mt-1">Low Bias / High Variance</div>
                        <div class="mt-2 text-[11px] bg-gray-100 p-1">เริ่มจำ Noise คะแนน Val ตก</div>
                      </div>
                      <div class="p-3 bg-[#E11D48]/10 border border-[#E11D48]">
                        <div class="text-[10px] font-bold text-[#BE123C]">4. UNRESTRICTED</div>
