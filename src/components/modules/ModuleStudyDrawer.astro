            <!-- ULTRA-DETAILED SECTIONS & TABLES -->
            <!-- ========================================================= -->
            <div class="space-y-6">
              {mod.sections.map((sec) => (
                <div class="rounded-3xl border border-slate-200/80 bg-white p-5 sm:p-7 shadow-[0_4px_24px_-4px_rgba(15,23,42,0.04)]">
