            <!-- ========================================================= -->
            <div class="space-y-3">
              <div class="flex items-center gap-2">
                <span class="soft-pill bg-rose-50 text-rose-700 border-rose-200 font-mono text-xs font-bold">
                  EXAM TRAPS ({mod.examTraps.length} จุดต้องระวัง)
                </span>
                <h3 class="font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] font-bold text-base sm:text-lg text-[#0F172A]">
                  กับดักข้อสอบอาจารย์ & วิธีคิดที่ถูกต้องตามสไลด์
                </h3>
              </div>

              <div class="grid grid-cols-1 gap-4">
                {mod.examTraps.map((trap, tIdx) => (
                  <div class="rounded-2xl border border-slate-200/80 bg-white shadow-2xs overflow-hidden">
                    <div class="bg-[#0F172A] text-white px-4 py-2.5 flex flex-wrap justify-between items-center gap-2 font-mono text-xs">
                      <span class="font-bold text-[#66A1EE]">
