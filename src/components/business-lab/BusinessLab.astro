---
// Business Context Lab - Sequential Locked Card Builder + Reverse Mode (Spec 13 & Hallmark Workbench)
---

<div class="business-lab-container space-y-8 select-none">
  <!-- Header: Single Layer Workbench Container -->
  <div class="bg-white rounded-2xl p-6 sm:p-7 border border-slate-200 shadow-xs">
    <div class="flex flex-wrap justify-between items-start gap-4">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-slate-500 mb-1">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
          <span>INTERACTIVE DECISION SIMULATOR · SPEC 13</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-extrabold font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] text-slate-900 tracking-tight">
          Business Context Lab & Decision Gates
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-xl">
          จำลองการตัดสินใจทางธุรกิจจริง: เชื่อมโยงต้นทุนความผิดพลาด FP/FN เข้ากับ Precision/Recall และประตูตัดสินใจ Lect 09–10
        </p>
      </div>

      <!-- Mode Switcher: Segmented Controls with 8px radius -->
      <div class="flex border border-slate-200 bg-slate-100 p-1 gap-1 rounded-lg">
        <button
          type="button"
          id="mode-builder-btn"
          class="px-3 py-1.5 text-xs font-mono font-semibold uppercase bg-slate-900 text-white rounded-md cursor-pointer transition-colors"
        >
          1. Sequential Card Builder
        </button>
        <button
          type="button"
          id="mode-reverse-btn"
          class="px-3 py-1.5 text-xs font-mono font-semibold uppercase bg-transparent text-slate-600 hover:text-slate-900 rounded-md cursor-pointer transition-colors"
        >
          2. Reverse Challenge Mode
        </button>
      </div>
    </div>
  </div>

  <!-- Mode 1: Sequential Locked Card Builder -->
  <div id="builder-mode-view" class="space-y-6">
    <!-- Step 1: Domain Selection -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
      <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-3">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-800 flex items-center gap-2.5">
          <span class="w-6 h-6 rounded-md bg-slate-900 text-white flex items-center justify-center font-bold text-xs">1</span>
          เลือกโดเมนธุรกิจ (Business Domain)
        </span>
        <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 border border-slate-200 text-[10px] font-mono font-bold">
          Lect 07 / Lect 09 Cases
        </span>
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <button
          type="button"
          data-domain="churn"
          class="domain-card rounded-xl border-2 border-blue-600 bg-blue-50/50 p-4 text-left transition-[border-color,background-color] cursor-pointer"
        >
          <div class="font-bold text-sm text-slate-900 font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif]">Customer Churn</div>
          <div class="text-xs text-slate-600 mt-1">การบ้านอาจารย์ HW#1 / HW#2 ลูกค้าเลิกใช้บริการ</div>
        </button>
        <button
          type="button"
          data-domain="medical"
          class="domain-card rounded-xl border border-slate-200 bg-white p-4 text-left hover:bg-slate-50 transition-[border-color,background-color] cursor-pointer"
        >
          <div class="font-bold text-sm text-slate-900 font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif]">Health-risk Algorithm</div>
          <div class="text-xs text-slate-600 mt-1">คดีจริง 2019 การคัดกรองผู้ป่วยความเสี่ยงสูง</div>
        </button>
        <button
          type="button"
          data-domain="hiring"
          class="domain-card rounded-xl border border-slate-200 bg-white p-4 text-left hover:bg-slate-50 transition-[border-color,background-color] cursor-pointer"
        >
          <div class="font-bold text-sm text-slate-900 font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif]">iTutorGroup HR AI</div>
          <div class="text-xs text-slate-600 mt-1">คดีจริง EEOC 2023 คัดกรองใบสมัครงาน</div>
        </button>
        <button
          type="button"
          data-domain="theft"
          class="domain-card rounded-xl border border-slate-200 bg-white p-4 text-left hover:bg-slate-50 transition-[border-color,background-color] cursor-pointer"
        >
          <div class="font-bold text-sm text-slate-900 font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif]">Rite Aid Retail Facial AI</div>
          <div class="text-xs text-slate-600 mt-1">คดีจริง FTC 2023 จับขโมยในร้านค้า</div>
        </button>
      </div>
    </div>

    <!-- Step 2: Positive Class Definition & 2x2 Matrix Cost Assignment -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      <!-- Left: Positive Class & Scenario Summary -->
      <div class="lg:col-span-5 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2.5 mb-4 border-b border-slate-100 pb-3">
            <span class="w-6 h-6 rounded-md bg-slate-900 text-white flex items-center justify-center font-bold text-xs">2</span>
            <span class="text-xs font-mono font-bold uppercase text-slate-800">กฎเหล็ก: เขียน Positive Class ก่อนเสมอ</span>
          </div>

          <div class="p-4 rounded-xl border border-slate-200 bg-slate-50 mb-5">
            <div class="text-slate-500 text-[10px] uppercase font-bold tracking-wider font-mono">Positive Class Defined As:</div>
            <div id="positive-class-text" class="text-base font-bold text-blue-700 mt-1 font-mono">
              Positive = 'Inactive / Churn = Yes'
            </div>
            <div id="positive-class-desc" class="text-xs text-slate-600 mt-1">
              เป้าหมายของโมเดลคือการตรวจจับลูกค้าที่มีความเสี่ยงจะเลิกใช้บริการ
            </div>
          </div>

          <div class="space-y-2.5 text-xs font-mono">
            <div class="p-3 rounded-lg bg-slate-50 border border-slate-200">
              <span class="font-bold text-slate-800">ต้นทุนความผิดพลาด FP (โทรไปรบกวน):</span>
              <p class="text-slate-600 mt-0.5">โทรไปหาลูกค้าที่ยังใช้บริการอยู่ มอบส่วนลดฟรี หรือรบกวนเวลา</p>
            </div>
            <div class="p-3 rounded-lg bg-rose-50 border border-rose-200">
              <span class="font-bold text-rose-800">ต้นทุนความผิดพลาด FN (ลูกค้าหนีหลุดมือ):</span>
              <p class="text-rose-900/90 mt-0.5">ลูกค้าเลิกใช้บริการจริง แต่โมเดลตรวจไม่พบ สูญเสีย Lifetime Value</p>
            </div>
          </div>
        </div>

        <div class="mt-5 pt-4 border-t border-slate-100 flex justify-between items-center text-xs font-mono">
          <span class="text-slate-600 font-medium">ความเสี่ยงสำคัญที่สุด:</span>
          <span id="primary-risk-badge" class="px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-[10px] font-bold">
            FN รุนแรงกว่า FP
          </span>
        </div>
      </div>

      <!-- Right: Interactive 2x2 Matrix & Metric Sensitivity -->
      <div class="lg:col-span-7 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
        <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-3">
          <span class="text-xs font-mono font-bold uppercase text-slate-800 flex items-center gap-2.5">
            <span class="w-6 h-6 rounded-md bg-slate-900 text-white flex items-center justify-center font-bold text-xs">3</span>
            ตารางถ่วงน้ำหนักต้นทุน 2x2 & Metric Sensitivity
          </span>
          <span class="text-[10px] font-mono text-slate-500 font-medium">Confusion Matrix Tradeoff</span>
        </div>

        <!-- 2x2 Matrix Grid -->
        <div class="grid grid-cols-2 gap-3 mb-4 text-xs font-mono">
          <!-- TP Box -->
          <div class="rounded-xl border border-emerald-200 bg-emerald-50/40 p-4">
            <div class="flex justify-between items-center">
              <span class="font-bold text-emerald-800">TRUE POSITIVE (TP)</span>
              <span class="px-1.5 py-0.2 rounded-md bg-emerald-100 text-emerald-800 border border-emerald-200 text-[10px] font-bold">ถูก</span>
            </div>
            <p class="text-slate-600 text-[11px] mt-1.5">โมเดลทายบวก และเป็นจริง จับได้ถูกต้อง</p>
          </div>

          <!-- FP Box -->
          <div id="box-fp" class="rounded-xl border border-amber-200 bg-amber-50/40 p-4 transition-colors">
            <div class="flex justify-between items-center">
              <span class="font-bold text-amber-800">FALSE POSITIVE (FP)</span>
              <span class="px-1.5 py-0.2 rounded-md bg-amber-100 text-amber-800 border border-amber-200 text-[10px] font-bold">ทายเกิน</span>
            </div>
            <div class="mt-2.5 flex items-center justify-between">
              <span class="text-[10px] text-slate-500 font-medium">ระดับต้นทุน:</span>
              <select id="select-fp-cost" class="rounded-md border border-slate-200 bg-white text-xs font-bold px-2 py-0.5 text-slate-800">
                <option value="low">ต่ำ (Low Cost)</option>
                <option value="med" selected>ปานกลาง (Med Cost)</option>
                <option value="high">รุนแรงมาก (Severe Cost)</option>
              </select>
            </div>
          </div>

          <!-- FN Box -->
          <div id="box-fn" class="rounded-xl border border-rose-200 bg-rose-50/40 p-4 transition-colors">
            <div class="flex justify-between items-center">
              <span class="font-bold text-rose-800">FALSE NEGATIVE (FN)</span>
              <span class="px-1.5 py-0.2 rounded-md bg-rose-100 text-rose-800 border border-rose-200 text-[10px] font-bold">หลุดเคส</span>
            </div>
            <div class="mt-2.5 flex items-center justify-between">
              <span class="text-[10px] text-slate-500 font-medium">ระดับต้นทุน:</span>
              <select id="select-fn-cost" class="rounded-md border border-slate-200 bg-white text-xs font-bold px-2 py-0.5 text-slate-800">
                <option value="low">ต่ำ (Low Cost)</option>
                <option value="med">ปานกลาง (Med Cost)</option>
                <option value="high" selected>รุนแรงสูงสุด (Fatal Churn)</option>
              </select>
            </div>
          </div>

          <!-- TN Box -->
          <div class="rounded-xl border border-blue-200 bg-blue-50/40 p-4">
            <div class="flex justify-between items-center">
              <span class="font-bold text-blue-800">TRUE NEGATIVE (TN)</span>
              <span class="px-1.5 py-0.2 rounded-md bg-blue-100 text-blue-800 border border-blue-200 text-[10px] font-bold">ถูก</span>
            </div>
            <p class="text-slate-600 text-[11px] mt-1.5">โมเดลทายลบ และเป็นลบจริง ปกติ</p>
          </div>
        </div>

        <!-- Metric Highlight Banner -->
        <div id="metric-output-banner" class="rounded-xl bg-slate-900 text-white p-4 font-mono">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs text-slate-400 font-bold uppercase tracking-wider">OPTIMIZATION METRIC MANDATED:</span>
            <span id="metric-name-badge" class="px-2 py-0.5 rounded-md bg-rose-500/20 text-rose-300 border border-rose-500/30 text-xs font-bold uppercase">
              RECALL (SENSITIVITY)
            </span>
          </div>
          <div id="metric-explanation" class="text-xs text-slate-300 leading-relaxed">
            เพราะต้นทุนของ False Negative รุนแรงกว่ามาก ต้องเลือกโมเดลที่ให้ค่า Recall สูงสุด (เช่น Model B ใน HW#2 ที่ให้ Recall 0.90) เพื่อป้องกันลูกค้าหลุดมือ!
          </div>
        </div>
      </div>
    </div>

    <!-- Step 3: Decision Gate (Lect 09 p36) -->
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
      <div class="flex items-center justify-between mb-4 border-b border-slate-100 pb-3">
        <span class="text-xs font-mono font-bold uppercase text-slate-800 flex items-center gap-2.5">
          <span class="w-6 h-6 rounded-md bg-slate-900 text-white flex items-center justify-center font-bold text-xs">4</span>
          ประตูตัดสินใจส่งมอบโมเดล (Decision Gates - Lect 09 p36)
        </span>
        <span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 border border-emerald-200 text-[10px] font-mono font-bold">
          Governance Checkpoint
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-mono text-xs">
        <button
          type="button"
          data-gate="accept"
          class="gate-card rounded-xl border border-slate-200 p-4 text-left hover:bg-slate-50 transition-colors cursor-pointer bg-white"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-sm text-emerald-700">1. ACCEPT</span>
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
          </div>
          <p class="text-slate-600 text-[11px] leading-relaxed">โมเดลผ่านการตรวจสอบด้านจริยธรรม Metric ตรงตามบริบทธุรกิจ พร้อม Deploy</p>
        </button>

        <button
          type="button"
          data-gate="revise"
          class="gate-card rounded-xl border-2 border-amber-400 bg-amber-50/50 p-4 text-left hover:bg-amber-50 transition-colors cursor-pointer"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-sm text-amber-800">2. REVISE</span>
            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
          </div>
          <p class="text-slate-700 text-[11px] leading-relaxed">ส่งกลับไปจูนในขั้นตอนเดิมของ CRISP-DS เช่น ปรับ Threshold หรือลบ Proxy Features</p>
        </button>

        <button
          type="button"
          data-gate="reject"
          class="gate-card rounded-xl border border-slate-200 p-4 text-left hover:bg-slate-50 transition-colors cursor-pointer bg-white"
        >
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-sm text-rose-700">3. REJECT</span>
            <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
          </div>
          <p class="text-slate-600 text-[11px] leading-relaxed">ปฏิเสธโมเดลเด็ดขาด เสี่ยงผิดกฎหมาย ละเมิดสิทธิ หรือความเสียหายเกินรับได้</p>
        </button>
      </div>
    </div>
  </div>

  <!-- Mode 2: Reverse Challenge Mode View (Hidden by default) -->
  <div id="reverse-mode-view" class="hidden space-y-6">
    <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
      <div class="border-b border-slate-100 pb-3 mb-5 flex justify-between items-center">
        <div>
          <span class="px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-xs font-mono font-bold">
            REVERSE CHALLENGE
          </span>
          <h3 class="font-bold text-lg font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] text-slate-900 mt-1">
            โจทย์ท้าทาย: วิเคราะห์ความเสี่ยงและเลือก Decision Gate จากสถิติ
          </h3>
        </div>
        <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 border border-slate-200 text-xs font-mono">
          Authentic Exam Scenario
        </span>
      </div>

      <!-- Challenge Card 1 -->
      <div class="rounded-xl border border-slate-200 p-4 bg-slate-50 mb-5 font-mono text-xs">
        <div class="font-bold text-sm text-slate-900 mb-1.5">
          คดี Rite Aid (FTC 2023-2024): ระบบ Facial Recognition แจ้งเตือนจับขโมย
        </div>
        <p class="text-slate-700 leading-relaxed mb-3">
          สถานการณ์: โมเดลมี Accuracy สูง 94% แต่เมื่อตรวจนับพบว่าแจ้งเตือนลูกค้าผิดคน (False Positive) จำนวนมาก ทำให้ผู้บริสุทธิ์ถูกเจ้าหน้าที่รักษาความปลอดภัยคุกคามและจับกุม
        </p>

        <div class="bg-white p-3 rounded-lg border border-slate-200 mb-3 font-medium">
          <span class="font-bold text-rose-600">คำถาม:</span> เมตริกใดที่โมเดลนี้สอบตกอย่างร้ายแรง และคณะกรรมการ FTC ตัดสินให้ลงที่ Decision Gate ใด?
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <button
            type="button"
            class="reverse-opt-btn rounded-lg border border-slate-200 bg-white p-3 text-left hover:bg-slate-50 transition-colors font-mono text-xs cursor-pointer"
            data-correct="false"
          >
            A. ตก Recall / ตัดสินใจ Accept เพราะ Accuracy รวมยังสูง 94%
          </button>
          <button
            type="button"
            class="reverse-opt-btn rounded-lg border border-slate-200 bg-white p-3 text-left hover:bg-slate-50 transition-colors font-mono text-xs cursor-pointer"
            data-correct="true"
          >
            B. ตก Precision (FP สูงมาก) / ตัดสินใจ Reject (FTC สั่งแบน 5 ปี และสั่งให้มี Human Checkpoint)
          </button>
        </div>
        <div class="reverse-feedback hidden mt-3 p-3 rounded-lg font-bold font-mono text-xs"></div>
      </div>

      <!-- Challenge Card 2 -->
      <div class="rounded-xl border border-slate-200 p-4 bg-slate-50 font-mono text-xs">
        <div class="font-bold text-sm text-slate-900 mb-1.5">
          การบ้าน HW#2: การเลือกโมเดล Customer Inactivity (100 ราย)
        </div>
        <p class="text-slate-700 leading-relaxed mb-3">
          โจทย์กำหนด: Model A (Acc=0.81, Prec=0.89, Rec=0.60) | Model B (Acc=0.78, Prec=0.67, Rec=0.90) | Model C (Acc=0.85, Prec=0.82, Rec=0.80)
        </p>

        <div class="bg-white p-3 rounded-lg border border-slate-200 mb-3 font-medium">
          <span class="font-bold text-rose-600">คำถาม:</span> หากฝ่ายการตลาดต้องการ "ความสมดุลสูงสุดระหว่างทุกมิติ" และ "กลัวลูกค้าเลิกใช้บริการมากที่สุด" ควรเลือกโมเดลใดตามลำดับ?
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
          <button
            type="button"
            class="reverse-opt-btn rounded-lg border border-slate-200 bg-white p-3 text-left hover:bg-slate-50 transition-colors font-mono text-xs cursor-pointer"
            data-correct="true"
          >
            A. สมดุลที่สุดเลือก Model C (F1 0.81, Acc 0.85) / กลัวลูกค้าหนีเลือก Model B (Recall 0.90)
          </button>
          <button
            type="button"
            class="reverse-opt-btn rounded-lg border border-slate-200 bg-white p-3 text-left hover:bg-slate-50 transition-colors font-mono text-xs cursor-pointer"
            data-correct="false"
          >
            B. ทั้งสองกรณีเลือก Model A เพราะมี Precision สูงสุด (0.89)
          </button>
        </div>
        <div class="reverse-feedback hidden mt-3 p-3 rounded-lg font-bold font-mono text-xs"></div>
      </div>
    </div>
  </div>
</div>

<script>
  // Mode switcher
  const builderBtn = document.getElementById('mode-builder-btn');
  const reverseBtn = document.getElementById('mode-reverse-btn');
  const builderView = document.getElementById('builder-mode-view');
  const reverseView = document.getElementById('reverse-mode-view');

  builderBtn?.addEventListener('click', () => {
    builderBtn.className = 'px-3 py-1.5 text-xs font-mono font-semibold uppercase bg-slate-900 text-white rounded-md cursor-pointer transition-colors';
    reverseBtn!.className = 'px-3 py-1.5 text-xs font-mono font-semibold uppercase bg-transparent text-slate-600 hover:text-slate-900 rounded-md cursor-pointer transition-colors';
    builderView?.classList.remove('hidden');
    reverseView?.classList.add('hidden');
  });

  reverseBtn?.addEventListener('click', () => {
    reverseBtn.className = 'px-3 py-1.5 text-xs font-mono font-semibold uppercase bg-slate-900 text-white rounded-md cursor-pointer transition-colors';
    builderBtn!.className = 'px-3 py-1.5 text-xs font-mono font-semibold uppercase bg-transparent text-slate-600 hover:text-slate-900 rounded-md cursor-pointer transition-colors';
    reverseView?.classList.remove('hidden');
    builderView?.classList.add('hidden');
  });

  // Domain configs
  const domainConfigs: Record<string, { posText: string; posDesc: string; fpCost: string; fnCost: string; risk: string }> = {
    churn: {
      posText: "Positive = 'Inactive / Churn = Yes'",
      posDesc: 'ตรวจจับลูกค้าที่จะเลิกใช้บริการ เพื่อติดต่อเสนอดีลพิเศษ',
      fpCost: 'med',
      fnCost: 'high',
      risk: 'FN รุนแรงกว่า FP (ลูกค้าหนี)',
    },
    medical: {
      posText: "Positive = 'High Disease Risk = Yes'",
      posDesc: 'คัดกรองผู้ป่วยอาการหนักเพื่อเข้าโครงการดูแลเข้มข้น',
      fpCost: 'low',
      fnCost: 'high',
      risk: 'FN เป็นอันตรายต่อชีวิต',
    },
    hiring: {
      posText: "Positive = 'Qualified Candidate = Yes'",
      posDesc: 'คัดกรองใบสมัครงานที่มีทักษะตรงตามเกณฑ์',
      fpCost: 'high',
      fnCost: 'med',
      risk: 'FP เสียเวลาสัมภาษณ์ / ละเมิดอายุ',
    },
    theft: {
      posText: "Positive = 'Shoplifter / Suspect = Yes'",
      posDesc: 'ระบบตรวจจับใบหน้าผู้ต้องสงสัยขโมยของในร้านค้า',
      fpCost: 'high',
      fnCost: 'med',
      risk: 'FP รุนแรงมาก (จับผู้บริสุทธิ์)',
    },
  };

  const domainCards = document.querySelectorAll<HTMLElement>('.domain-card');
  const posTextEl = document.getElementById('positive-class-text');
  const posDescEl = document.getElementById('positive-class-desc');
  const riskBadgeEl = document.getElementById('primary-risk-badge');
  const fpSelect = document.getElementById('select-fp-cost') as HTMLSelectElement;
  const fnSelect = document.getElementById('select-fn-cost') as HTMLSelectElement;
  const metricBadge = document.getElementById('metric-name-badge');
  const metricExplanation = document.getElementById('metric-explanation');

  domainCards.forEach((card) => {
    card.addEventListener('click', () => {
      domainCards.forEach((c) => {
        c.classList.remove('border-2', 'border-blue-600', 'bg-blue-50/50');
        c.classList.add('border', 'border-slate-200', 'bg-white');
      });
      card.classList.remove('border', 'border-slate-200', 'bg-white');
      card.classList.add('border-2', 'border-blue-600', 'bg-blue-50/50');

      const domainKey = card.getAttribute('data-domain') || 'churn';
      const config = domainConfigs[domainKey];
      if (config) {
        if (posTextEl) posTextEl.textContent = config.posText;
        if (posDescEl) posDescEl.textContent = config.posDesc;
        if (riskBadgeEl) riskBadgeEl.textContent = config.risk;
        if (fpSelect) fpSelect.value = config.fpCost;
        if (fnSelect) fnSelect.value = config.fnCost;
        updateMetricState();
      }
    });
  });

  fpSelect?.addEventListener('change', updateMetricState);
  fnSelect?.addEventListener('change', updateMetricState);

  function updateMetricState() {
    const fp = fpSelect.value;
    const fn = fnSelect.value;

    if (fn === 'high' && fp !== 'high') {
      metricBadge!.textContent = 'RECALL (SENSITIVITY)';
      metricBadge!.className = 'px-2 py-0.5 rounded-md bg-rose-500/20 text-rose-300 border border-rose-500/30 text-xs font-bold uppercase';
      metricExplanation!.textContent = 'เพราะต้นทุนของ False Negative รุนแรงกว่ามาก ต้องเลือกโมเดลที่ให้ค่า Recall สูงสุด เพื่อลดโอกาสหลุดเคสบวก (เช่น ในการบ้าน HW#2 เลือก Model B ที่มี Recall 0.90)';
    } else if (fp === 'high' && fn !== 'high') {
      metricBadge!.textContent = 'PRECISION';
      metricBadge!.className = 'px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 text-xs font-bold uppercase';
      metricExplanation!.textContent = 'เพราะต้นทุนของ False Positive มีความเสียหายสูงมาก (เช่น ฟ้องร้องทางกฎหมาย หรือรบกวนลูกค้า) โมเดลต้องเน้น Precision สูงเพื่อไม่ให้ทายมั่ว (เช่น คดี Rite Aid)';
    } else {
      metricBadge!.textContent = 'F1-SCORE (BALANCED)';
      metricBadge!.className = 'px-2 py-0.5 rounded-md bg-blue-500/20 text-blue-300 border border-blue-500/30 text-xs font-bold uppercase';
      metricExplanation!.textContent = 'เมื่อทั้ง FP และ FN มีความสำคัญใกล้เคียงกัน ให้ใช้ F1-Score เป็นเกณฑ์หลักในการเปรียบเทียบโมเดล (เช่น ใน HW#2 เลือก Model C ที่ชนะด้วย F1 = 0.81)';
    }
  }

  // Reverse challenge options
  document.querySelectorAll<HTMLElement>('.reverse-opt-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isCorrect = btn.getAttribute('data-correct') === 'true';
      const parent = btn.closest('.rounded-xl');
      const feedback = parent?.querySelector<HTMLElement>('.reverse-feedback');
      if (feedback) {
        feedback.classList.remove('hidden');
        if (isCorrect) {
          feedback.textContent = '[CORRECT] วิเคราะห์ตรงตามเกณฑ์ต้นทุนความผิดพลาด (FP vs FN) ในสไลด์อาจารย์';
          feedback.className = 'reverse-feedback mt-3 p-3 rounded-md font-bold font-mono text-xs bg-emerald-50 text-emerald-800 border border-emerald-200';
        } else {
          feedback.textContent = '[INCORRECT] ยังไม่ตรงเกณฑ์ ลองเปรียบเทียบผลกระทบของ FP กับ FN อีกครั้ง';
          feedback.className = 'reverse-feedback mt-3 p-3 rounded-md font-bold font-mono text-xs bg-rose-50 text-rose-800 border border-rose-200';
        }
      }
    });
  });
</script>
