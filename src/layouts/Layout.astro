---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeTab?: 'home' | 'modules' | 'formulas' | 'business-lab' | 'exam' | 'dashboard';
  ogImage?: string;
}

const {
  title = '10301351 Data Science Final Exam Intensive Study Guide',
  description = 'Webapp ทบทวนสอบ Final วิชา 10301351 Data Science ครบถ้วนทุกสูตร ตัวอย่างจริง และกับดักข้อสอบ',
  activeTab = 'home',
  ogImage = '/og-image.png',
} = Astro.props;

const navLinks = [
  { href: '/',              label: 'หลักสูตร',      tab: 'home' },
  { href: '/formulas',      label: 'สูตร',          tab: 'formulas' },
  { href: '/business-lab',  label: 'Business Lab',  tab: 'business-lab' },
  { href: '/exam',          label: 'ห้องสอบ',       tab: 'exam' },
  { href: '/dashboard',     label: 'Mastery',       tab: 'dashboard' },
];
---

<!doctype html>
<html lang="th" class="overflow-x-hidden max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#FFFFFF" />
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const theme = stored || (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        const metaTheme = document.querySelector('meta[name="theme-color"]');
        if (metaTheme) metaTheme.setAttribute('content', theme === 'dark' ? '#0B1120' : '#FFFFFF');
        const btn = document.getElementById('theme-toggle-btn');
        const icon = document.getElementById('theme-icon');
        if (btn) btn.setAttribute('aria-pressed', String(theme === 'dark'));
        if (icon) icon.textContent = theme === 'dark' ? '☀️' : '🌙';
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts: Google Sans (Thai subset), Space Grotesk, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Google+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&subset=latin,thai&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#F8FAFC] text-[#0F172A] min-h-screen flex flex-col font-['Google_Sans',_'Google_Sans_Thai',_sans-serif] overflow-x-hidden max-w-full">
    <!-- Skip Link for Accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-white focus:text-[#2563EB] focus:px-4 focus:py-2 focus:font-bold focus:border focus:border-[#66A1EE]">
      ข้ามไปยังเนื้อหาหลัก
    </a>

    <!-- Floating navbar -->
    <header class="sticky top-3 z-40 px-3 sm:px-6 mb-8">
      <div class="max-w-6xl mx-auto flex items-center gap-1.5 sm:gap-2 px-2 py-1.5 bg-white/95 backdrop-blur-md rounded-2xl border border-slate-200/70 shadow-[0_1px_2px_rgba(15,23,42,0.04),0_12px_32px_-12px_rgba(15,23,42,0.12)]">

        <!-- Brand: monogram + course code in one text run -->
        <a href="/" aria-label="กลับหน้าหลัก" class="shrink-0 flex items-center px-2.5 py-1.5 rounded-lg hover:bg-slate-50 transition-colors">
          <span class="font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] font-bold text-[13px] tracking-tight text-slate-900">
            DS<span class="text-slate-400 font-mono font-normal ml-1.5">10301351</span>
          </span>
        </a>

        <div class="w-px h-4 bg-slate-200 shrink-0" aria-hidden="true"></div>

        <!-- Nav tabs -->
        <nav class="flex items-center gap-0.5 overflow-x-auto scrollbar-hide flex-1 min-w-0" role="navigation" aria-label="เมนูหลัก">
          {navLinks.map((link) => {
            const isActive = activeTab === link.tab || (link.tab === 'home' && activeTab === 'modules');
            return (
              <a
                href={link.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'px-3 py-1.5 text-[13px] rounded-lg whitespace-nowrap transition-colors',
                  isActive
                    ? 'bg-slate-900 text-white font-medium'
                    : 'text-slate-500 hover:text-slate-900 hover:bg-slate-100',
                ]}
              >
                {link.label}
              </a>
            );
          })}
        </nav>

        <!-- Focus toggle: status dot เป็น indicator เดียว -->
        <button
          id="focus-toggle-btn"
          type="button"
          data-active="true"
          aria-pressed="true"
          aria-label="สลับโหมดเน้นข้อสอบ Final"
          class="shrink-0 inline-flex items-center gap-2 pl-2.5 pr-3 py-1.5 text-[11px] font-mono tracking-wide rounded-lg border transition-colors cursor-pointer select-none"
        >
          <span id="focus-toggle-dot" class="w-1.5 h-1.5 rounded-full"></span>
          <span id="focus-toggle-label">FOCUS · L05–10</span>
        </button>
        <button
          id="theme-toggle-btn"
          type="button"
          aria-label="สลับโหมดสี"
          aria-pressed="false"
          class="shrink-0 inline-flex items-center gap-1.5 pl-2.5 pr-3 py-1.5 text-[11px] font-mono tracking-wide rounded-lg border border-slate-200/80 bg-white text-slate-600 transition-colors cursor-pointer select-none hover:bg-slate-50 hover:border-slate-300"
          onclick="(function(){const html=document.documentElement;const cur=html.getAttribute('data-theme')||'light';const next=cur==='dark'?'light':'dark';html.setAttribute('data-theme',next);localStorage.setItem('theme',next);this.setAttribute('aria-pressed',String(next==='dark'));})();"
        >
          <svg class="w-3.5 h-3.5 text-slate-500" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386-1.591 1.591M21 12h-2.25m-.386 6.364-1.591-1.591M12 18.75V21m-4.773-4.227-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0Z" />
          </svg>
          <span>THEME</span>
        </button>
      </div>
    </header>

    <!-- Main Content Container -->
    <main id="main-content" class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6 min-w-0 overflow-x-hidden overflow-x-clip">
      <slot />
    </main>

    <!-- Footer: Ft2 Inline Single Line Colophon -->
    <footer class="border-t border-slate-200 bg-white py-6 px-4 mt-auto">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-mono text-slate-500">
        <div>
          <span class="font-bold text-slate-900">10301351 DATA SCIENCE EXAM GUIDE</span> — Final Core: Lectures 05–10
        </div>
        <div class="flex items-center gap-3">
          <span>CRISP-DS</span>
          <span class="text-slate-300">·</span>
          <span>14 Formulas</span>
          <span class="text-slate-300">·</span>
          <span>Exam Simulator</span>
        </div>
      </div>
    </footer>

    <!-- Global Final Focus Mode Script & KaTeX Setup -->
    <style is:global>
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* Hide scrollbar for nav on mobile */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      /* Focus Mode Transitions */
      body.final-focus-active .non-final-content {
        opacity: 0.4;
        filter: grayscale(0.8);
        pointer-events: none;
        transition: all 0.4s ease-in-out;
      }

      /* Skip link focus style */
      .sr-only:focus {
        clip: auto;
        width: auto;
        height: auto;
        margin: 0;
        overflow: visible;
        position: absolute;
        white-space: nowrap;
      }
    </style>

    <script>
      const STORAGE_KEY = 'ds_final_focus';
      const btn   = document.getElementById('focus-toggle-btn');
      const label = document.getElementById('focus-toggle-label');

      if (btn && label) {
        const saved   = localStorage.getItem(STORAGE_KEY);
        const initial = saved !== 'false'; // default = on

        const apply = (active: boolean) => {
          btn.setAttribute('data-active', String(active));
          btn.setAttribute('aria-pressed', String(active));
          label.textContent = active ? 'FOCUS · L05–10' : 'ALL LECTURES';
          document.body.classList.toggle('final-focus-active', active);
        };

        apply(initial);

        btn.addEventListener('click', () => {
          const next = btn.getAttribute('data-active') !== 'true';
          localStorage.setItem(STORAGE_KEY, String(next));
          apply(next);
          window.dispatchEvent(new CustomEvent('final-focus-change', {
            detail: { isFocus: next },
          }));
        });
      }
    </script>

    <script is:inline>
      (function() {
        const update = () => {
          const btn = document.getElementById('theme-toggle-btn');
          const icon = document.getElementById('theme-icon');
          if (!btn) return;
          const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
          btn.setAttribute('aria-pressed', String(isDark));
          if (icon) icon.textContent = isDark ? '☀️' : '🌙';
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', update);
        } else {
          update();
        }
        window.addEventListener('storage', update);
      })();
    </script>
    <!-- Lenis Smooth Scrolling Engine synchronized with GSAP ticker & ScrollTrigger -->
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const lenis = new Lenis({
        duration: 1.15,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1.0,
        touchMultiplier: 1.5,
      });

      // Synchronize Lenis scroll position with GSAP ScrollTrigger
      lenis.on('scroll', ScrollTrigger.update);

      // Synchronize Lenis with GSAP ticker for unified frame timing
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      // Expose globally for modals or components
      (window as any).lenis = lenis;
      (window as any).ScrollTrigger = ScrollTrigger;

      // Handle anchor links with smooth scroll via Lenis
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement)?.closest('a');
        if (!target) return;
        const href = target.getAttribute('href');
        if (!href) return;

        // Check if internal hash link (e.g., #formulas or /current-path#target)
        if (href.startsWith('#') && href.length > 1) {
          const el = document.querySelector(href);
          if (el) {
            e.preventDefault();
            lenis.scrollTo(el, { offset: -24 });
          }
        }
      });

      // If initial page loads with a hash, smooth scroll to it
      if (window.location.hash) {
        setTimeout(() => {
          const targetEl = document.querySelector(window.location.hash);
          if (targetEl) {
            lenis.scrollTo(targetEl, { offset: -24, immediate: false });
          }
        }, 150);
      }

      // Minimal GSAP entrance animation on MAIN block elements using ScrollTrigger (start: 'top 90%')
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        // Ensure initial focus filter state is reflected before measuring ScrollTrigger positions
        const savedFocus = localStorage.getItem('ds_final_focus');
        const isFocus = savedFocus !== null ? savedFocus === 'true' : true;
        if (isFocus) {
          document.querySelectorAll<HTMLElement>('.module-card[data-focus="false"]').forEach((card) => {
            card.classList.add('hidden');
          });
        }

        // Select main standalone blocks/cards across pages (excluding giant page-wrappers and inner sub-elements)
        const rawCandidates = Array.from(
          document.querySelectorAll<HTMLElement>(
            [
              '#main-content > section:first-of-type',
              '#main-content > section:nth-of-type(2) > div:first-child',
              '.module-card',
              '#main-content > section:nth-of-type(3)',
              '#main-content > div:not(.business-lab-container):not(.exam-arena-container):not(#formulas-list):not(#module-study-modal)',
              '#main-content > div:nth-of-type(2) > div',
              '#main-content > div:nth-of-type(3) > div',
              '.formula-section',
              '.business-lab-container > div:first-child',
              '#builder-mode-view > div',
              '.exam-arena-container > div:first-child',
              '.exam-arena-container .lg\\:col-span-8 > div',
              '.exam-arena-container .lg\\:col-span-4 > div',
            ].join(', ')
          )
        );

        // Filter out any container that wraps another matched main element so only the main block itself animates
        const mainElements = rawCandidates.filter(
          (el) => !rawCandidates.some((other) => other !== el && el.contains(other))
        );

        mainElements.forEach((el) => {
          if (el.classList.contains('hidden')) return;

          gsap.from(el, {
            y: 28,
            opacity: 0,
            duration: 0.55,
            ease: 'power2.out',
            onComplete: () => {
              gsap.set(el, { clearProps: 'transform,opacity' });
            },
            scrollTrigger: {
              trigger: el,
              start: 'top 90%',
              toggleActions: 'play none none none',
              once: true,
            },
          });
        });

        // Refresh ScrollTrigger positions when filters toggle visibility
        window.addEventListener('final-focus-change', () => {
          setTimeout(() => ScrollTrigger.refresh(), 50);
        });
        document.querySelectorAll('#filter-all-btn, #filter-focus-btn, .cat-filter-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            setTimeout(() => ScrollTrigger.refresh(), 50);
          });
        });
      }
    </script>



  </body>
</html>