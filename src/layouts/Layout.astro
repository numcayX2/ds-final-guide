---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  activeTab?: 'modules' | 'formulas' | 'business-lab' | 'exam' | 'dashboard';
  ogImage?: string;
}

const {
  title = '10301351 Data Science Final Exam Intensive Study Guide',
  description = 'Webapp ทบทวนสอบ Final วิชา 10301351 Data Science ครบถ้วนทุกสูตร ตัวอย่างจริง และกับดักข้อสอบ',
  activeTab = 'modules',
  ogImage = '/og-image.png',
} = Astro.props;

const navLinks = [
  { href: '/', label: '01. บทเรียน (9 บท)', tab: 'modules' },
  { href: '/formulas', label: '02. แอนิเมชัน 14 สูตร', tab: 'formulas' },
  { href: '/business-lab', label: '03. Business Lab', tab: 'business-lab' },
  { href: '/exam', label: '04. ห้องสอบจำลอง', tab: 'exam' },
  { href: '/dashboard', label: '05. Mastery', tab: 'dashboard' },
];
---

<!doctype html>
<html lang="th" class="overflow-x-hidden max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#171719" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts: Space Grotesk, Syne, Plus Jakarta Sans, Prompt, JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Thai:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Prompt:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&family=Syne:wght@700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Prevent FOUC: Add js-ready class synchronously before first paint -->
    <script is:inline>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-ready');
      }
    </script>
    <noscript>
      <style>
        .gsap-reveal { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
  </head>
  <body class="bg-[#F4F1EA] text-[#171719] min-h-screen flex flex-col font-['Plus_Jakarta_Sans',_'IBM_Plex_Sans_Thai',_sans-serif] overflow-x-hidden max-w-full">
    <!-- Skip Link for Accessibility -->
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-[#171719] focus:text-[#A3E635] focus:px-4 focus:py-2 focus:font-bold focus:border-2 focus:border-[#A3E635]">
      ข้ามไปยังเนื้อหาหลัก
    </a>

    <!-- Top Announcement Tape Bar -->
    <div class="bg-[#171719] text-[#F4F1EA] text-xs font-mono py-1.5 px-4 flex justify-between items-center border-b border-[#171719] select-none overflow-hidden">
      <div class="flex items-center gap-2 whitespace-nowrap">
        <span class="inline-block w-2 h-2 rounded-full bg-[#A3E635] animate-pulse"></span>
        <span class="tracking-wider uppercase font-semibold">10301351 DATA SCIENCE • FINAL EXAM PREPARATION CORE</span>
      </div>
      <div class="hidden sm:flex items-center gap-4 text-xs opacity-80 whitespace-nowrap">
        <span>CRISP-DS 8 STEPS</span>
        <span class="text-[#A3E635]">•</span>
        <span>14 FORMULA DERIVATIONS</span>
        <span class="text-[#A3E635]">•</span>
        <span>LECTURES 01–09 COMPLIANT</span>
      </div>
    </div>

    <!-- Main Navigation Header -->
    <header class="border-b-2 border-[#171719] bg-[#F4F1EA]/95 sticky top-0 z-40 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-wrap justify-between items-center gap-4">
        <!-- Logo / Brand -->
        <a href="/" class="flex items-center gap-3 group" aria-label="กลับหน้าหลัก">
          <div class="w-10 h-10 bg-[#171719] text-[#A3E635] flex items-center justify-center font-black font-['Space_Grotesk'] text-xl border border-[#171719] shadow-[3px_3px_0px_#A3E635] group-hover:translate-x-0.5 group-hover:translate-y-0.5 group-active:translate-x-1 group-active:translate-y-1 group-active:shadow-none transition-all">
            DS
          </div>
          <div class="hidden sm:block">
            <div class="font-['Space_Grotesk'] font-extrabold text-lg leading-tight tracking-tight flex items-center gap-2">
              <span>DATA SCIENCE 10301351</span>
              <span class="tape-label bg-[#A3E635] text-[#171719] text-[10px] py-0 px-1.5 -rotate-2">FINAL v2.0</span>
            </div>
            <p class="text-xs text-[#171719] opacity-70 font-mono">Interactive Formula Derivations & Exam Review</p>
          </div>
        </a>

        <!-- Navigation Tabs -->
        <nav class="flex items-center gap-1 sm:gap-2 overflow-x-auto pb-1 -mb-1 scrollbar-hide" role="navigation" aria-label="เมนูหลัก">
          {navLinks.map((link) => (
            <a
              href={link.href}
              aria-current={activeTab === link.tab ? 'page' : undefined}
              class:list={[
                'nav-link px-3 py-2 text-xs sm:text-sm font-bold border border-[#171719] transition-all whitespace-nowrap min-h-[44px] flex items-center',
                activeTab === link.tab
                  ? 'bg-[#171719] text-[#F4F1EA] shadow-[2px_2px_0px_#A3E635] translate-x-0.5 translate-y-0.5'
                  : 'bg-transparent text-[#171719] hover:bg-[#EAE6DC] hover:shadow-[2px_2px_0px_#171719] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none',
              ]}
            >
              {link.label}
            </a>
          ))}
        </nav>

        <!-- Final Focus Mode Toggle (Spec 1: default ON) -->
        <div class="flex items-center gap-2 border-2 border-[#171719] px-2.5 py-1 bg-white shadow-[2px_2px_0px_#171719] min-h-[44px]">
          <span class="text-xs font-mono font-bold tracking-tight hidden sm:inline">FINAL FOCUS:</span>
          <button
            id="focus-toggle-btn"
            type="button"
            aria-pressed="true"
            aria-label="สลับโหมดเน้นข้อสอบ Final"
            class="px-3 py-1 text-xs font-mono font-extrabold uppercase bg-[#A3E635] text-[#171719] border border-[#171719] cursor-pointer hover:opacity-90 active:scale-95 transition-all min-h-[32px]"
            data-active="true"
          >
            ON (Lect 05–09)
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main id="main-content" class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 min-w-0 overflow-x-hidden overflow-x-clip">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t-2 border-[#171719] bg-[#EAE6DC] py-6 px-4 mt-auto">
      <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-4 text-xs font-mono text-[#171719]">
        <div class="text-center sm:text-left">
          <span class="font-bold">10301351 DATA SCIENCE EXAM GUIDE</span> — Verified against authentic lecture slides (Lect 01–09).
        </div>
        <div class="flex items-center gap-4 flex-wrap justify-center">
          <span class="font-bold text-gray-700">Course Review Companion</span>
          <span class="text-[#A3E635]">•</span>
          <span>Astro + GSAP + KaTeX</span>
        </div>
      </div>
    </footer>

    <!-- Global Final Focus Mode Script & KaTeX Setup -->
    <style is:global>
      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
      }

      /* Hide scrollbar for nav on mobile */
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }

      /* Focus Mode Transitions */
      body.final-focus-active .non-final-content {
        opacity: 0.4;
        filter: grayscale(0.8);
        pointer-events: none;
        transition: all 0.4s ease-in-out;
      }

      /* Skip link focus style */
      .sr-only:focus {
        clip: auto;
        width: auto;
        height: auto;
        margin: 0;
        overflow: visible;
        position: absolute;
        white-space: nowrap;
      }
    </style>

    <script>
      // Load saved state or default to true
      const savedFocus = localStorage.getItem('ds_final_focus');
      const isFocus = savedFocus !== null ? savedFocus === 'true' : true;
      
      const toggleBtn = document.getElementById('focus-toggle-btn');
      if (toggleBtn) {
        updateFocusUI(isFocus);
        toggleBtn.addEventListener('click', () => {
          const current = toggleBtn.getAttribute('data-active') === 'true';
          const next = !current;
          localStorage.setItem('ds_final_focus', String(next));
          updateFocusUI(next);
          // Broadcast custom event for other components to listen to
          window.dispatchEvent(new CustomEvent('final-focus-change', { detail: { isFocus: next } }));
        });
      }

      function updateFocusUI(active: boolean) {
        if (!toggleBtn) return;
        toggleBtn.setAttribute('data-active', String(active));
        toggleBtn.setAttribute('aria-pressed', String(active));
        
        if (active) {
          toggleBtn.textContent = 'ON (Lect 05–09)';
          toggleBtn.className = 'px-3 py-1 text-xs font-mono font-extrabold uppercase bg-[#A3E635] text-[#171719] border border-[#171719] cursor-pointer hover:opacity-90 active:scale-95 transition-all min-h-[32px]';
          document.body.classList.add('final-focus-active');
        } else {
          toggleBtn.textContent = 'OFF (All 9 Lects)';
          toggleBtn.className = 'px-3 py-1 text-xs font-mono font-extrabold uppercase bg-gray-200 text-gray-700 border border-gray-500 cursor-pointer hover:opacity-90 active:scale-95 transition-all min-h-[32px]';
          document.body.classList.remove('final-focus-active');
        }
      }
    </script>

    <!-- Lenis Smooth Scrolling Engine synchronized with GSAP ticker -->
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';

      const lenis = new Lenis({
        duration: 1.15,
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        orientation: 'vertical',
        gestureOrientation: 'vertical',
        smoothWheel: true,
        wheelMultiplier: 1.0,
        touchMultiplier: 1.5,
      });

      // Synchronize Lenis with GSAP ticker for unified frame timing
      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });
      gsap.ticker.lagSmoothing(0);

      // Expose globally for modals or components
      (window as any).lenis = lenis;

      // Handle anchor links with smooth scroll via Lenis
      document.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement)?.closest('a');
        if (!target) return;
        const href = target.getAttribute('href');
        if (!href) return;

        // Check if internal hash link (e.g., #formulas or /current-path#target)
        if (href.startsWith('#') && href.length > 1) {
          const el = document.querySelector(href);
          if (el) {
            e.preventDefault();
            lenis.scrollTo(el, { offset: -24 });
          }
        }
      });

      // If initial page loads with a hash, smooth scroll to it
      if (window.location.hash) {
        setTimeout(() => {
          const targetEl = document.querySelector(window.location.hash);
          if (targetEl) {
            lenis.scrollTo(targetEl, { offset: -24, immediate: false });
          }
        }, 150);
      }

      // Minimal GSAP entrance animation strictly for MAIN top-level elements (Zero Blink / 90% Trigger)
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!prefersReducedMotion) {
        // Select only main top-level containers/sections (NOT individual sub-cards or inner buttons)
        const mainElements = Array.from(
          document.querySelectorAll<HTMLElement>('#main-content > section, #main-content > div:not(#module-study-modal)')
        );

        // IntersectionObserver triggering when top of element reaches 90% of screen height
        // rootMargin bottom: -10% means the trigger line is at 100% - 10% = 90% of viewport height
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                const el = entry.target as HTMLElement;
                observer.unobserve(el);

                // Animate main element smoothly to normal position
                gsap.from(el, {
                  y: 24,
                  opacity: 0,
                  duration: 0.5,
                  ease: 'power2.out',
                  clearProps: 'transform,opacity',
                });
                el.classList.remove('gsap-reveal');
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0 }
        );

        const screenTriggerLine = window.innerHeight * 0.9;

        mainElements.forEach((el, index) => {
          const rect = el.getBoundingClientRect();

          if (rect.top <= screenTriggerLine) {
            // Already above 90% screen height on initial load: animate immediately with slight sequence
            gsap.from(el, {
              y: 20,
              opacity: 0,
              duration: 0.5,
              delay: index * 0.08,
              ease: 'power2.out',
              clearProps: 'transform,opacity',
            });
          } else {
            // Below 90% screen height: pre-hide with .gsap-reveal (opacity 0, translateY) and wait for scroll
            el.classList.add('gsap-reveal');
            observer.observe(el);
          }
        });
      }
    </script>


  </body>
</html>