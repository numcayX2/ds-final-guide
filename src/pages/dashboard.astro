---
import Layout from '../layouts/Layout.astro';
import { allModules } from '../data/modules/index';
import { allFormulas } from '../data/formulas/index';
---

<Layout title="10301351 Data Science - แดชบอร์ดวิเคราะห์ความพร้อม (Mastery Dashboard)" activeTab="dashboard">
  <!-- Dashboard Hero: Workbench Instrument Container -->
  <div class="bg-white rounded-2xl p-6 sm:p-7 mb-8 border border-slate-200 shadow-xs">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
      <div class="lg:col-span-8">
        <div class="inline-flex items-center gap-2 text-xs font-mono text-slate-500 mb-1">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
          <span>PERSONAL DIAGNOSTIC & MASTERY TRACKER</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] text-slate-900 tracking-tight">
          Mastery Progress & Readiness
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-xl">
          ระบบติดตามความพร้อมรายบุคคล วิเคราะห์จุดอ่อนจากผลสอบจำลอง และจัดลำดับแผนทบทวน 6 รอบ
        </p>
      </div>

      <!-- Dominant Readiness Index Indicator -->
      <div class="lg:col-span-4 bg-slate-50 border border-slate-200 p-4 rounded-xl text-center font-mono">
        <div class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">ดัชนีความพร้อมรวม (Overall Readiness)</div>
        <div class="text-3xl sm:text-4xl font-extrabold text-blue-600 mt-1 tabular-nums" id="overall-pct">
          0%
        </div>
        <div class="text-[11px] text-slate-600 font-medium mt-1" id="overall-status">
          ยังไม่ได้เริ่มทดสอบ
        </div>
      </div>
    </div>
  </div>

  <!-- Telemetry Diagnostic Metrics: Asymmetric 3-Row Telemetry Panel -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8 font-mono text-xs">
    <!-- Stat 1: Modules Read -->
    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-xs">
      <div class="flex justify-between items-center mb-2">
        <span class="font-bold text-slate-800 uppercase">บทเรียนที่อ่านจบแล้ว</span>
        <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 border border-slate-200 text-[10px] font-bold tabular-nums" id="stat-mod-ratio">0 / 10</span>
      </div>
      <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden my-2">
        <div id="bar-mod" class="bg-blue-600 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
      </div>
      <p class="text-slate-500 text-[11px]">ครอบคลุมเนื้อหา 10 เลกเชอร์ของวิชา</p>
    </div>

    <!-- Stat 2: Formula Mastery -->
    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-xs">
      <div class="flex justify-between items-center mb-2">
        <span class="font-bold text-slate-800 uppercase">สูตรที่เข้าใจแล้ว</span>
        <span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 border border-slate-200 text-[10px] font-bold tabular-nums" id="stat-formula-ratio">0 / 14</span>
      </div>
      <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden my-2">
        <div id="bar-formula" class="bg-blue-600 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
      </div>
      <p class="text-slate-500 text-[11px]">14 แอนิเมชัน KaTeX Morphing</p>
    </div>

    <!-- Stat 3: Exam Score -->
    <div class="bg-white rounded-xl p-4 border border-slate-200 shadow-xs">
      <div class="flex justify-between items-center mb-2">
        <span class="font-bold text-slate-800 uppercase">คะแนนสอบจำลองล่าสุด</span>
        <span class="px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 border border-rose-200 text-[10px] font-bold tabular-nums" id="stat-exam-ratio">ยังไม่ได้สอบ</span>
      </div>
      <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden my-2">
        <div id="bar-exam" class="bg-rose-500 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
      </div>
      <p class="text-slate-500 text-[11px]">เป้าหมาย: ≥ 12 / 14 ข้อ (เกณฑ์เกรด A)</p>
    </div>
  </div>

  <!-- Detailed Checklists Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Left: Modules Checklist -->
    <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-xs">
      <div class="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
        <h3 class="font-bold text-sm sm:text-base font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] text-slate-900">
          01. เช็กลิสต์ความเข้าใจรายบทเรียน (10 บท)
        </h3>
        <span class="text-xs font-mono text-slate-500">คลิกเพื่อเช็กสถานะ</span>
      </div>

      <div class="space-y-2">
        {allModules.map((mod) => (
          <div
            class="flex items-center justify-between p-2.5 border border-slate-200 bg-slate-50 hover:bg-slate-100/80 rounded-lg transition-colors font-mono text-xs"
            data-mod-row={mod.id}
          >
            <div class="flex items-center gap-2.5">
              <input
                type="checkbox"
                class="mod-check w-4 h-4 border border-slate-300 bg-white rounded accent-blue-600 cursor-pointer"
                data-mod-id={mod.id}
              />
              <span class="font-bold text-slate-900">
                {mod.moduleNumber}. {mod.title}
              </span>
            </div>
            <span class="px-2 py-0.5 rounded-md bg-white border border-slate-200 text-[10px] text-slate-600">
              {mod.lectureCode}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Right: Formulas Mastery Grid -->
    <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-xs">
      <div class="flex justify-between items-center mb-4 border-b border-slate-100 pb-3">
        <h3 class="font-bold text-sm sm:text-base font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] text-slate-900">
          02. เช็กลิสต์ความเชี่ยวชาญ 14 สูตรคำนวณ
        </h3>
        <span class="text-xs font-mono text-slate-500">คลิกเพื่อเช็กสถานะ</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        {allFormulas.map((formula, i) => (
          <div
            class="p-2 border border-slate-200 bg-slate-50 hover:bg-slate-100/80 rounded-lg transition-colors font-mono text-xs flex items-center justify-between"
            data-formula-row={formula.id}
          >
            <div class="flex items-center gap-2 truncate pr-1">
              <input
                type="checkbox"
                class="formula-check w-4 h-4 border border-slate-300 bg-white rounded accent-blue-600 cursor-pointer shrink-0"
                data-formula-id={formula.id}
              />
              <a href={`/formulas#${formula.id}`} class="truncate hover:text-blue-600 font-medium text-slate-800 transition-colors">
                {String(i + 1).padStart(2, '0')}. {formula.name}
              </a>
            </div>
            <span class="text-[9px] uppercase px-1.5 py-0.2 bg-white border border-slate-200 text-slate-500 rounded-md shrink-0 font-bold">
              {formula.category}
            </span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Section 3: 6-Round Study Plan from Friend's Guide -->
  <div class="bg-white rounded-2xl p-5 sm:p-6 border border-slate-200 shadow-xs mb-8 font-mono text-xs">
    <div class="border-b border-slate-100 pb-3 mb-4 flex justify-between items-center">
      <div>
        <span class="text-xs font-bold text-blue-600 uppercase">STUDY ROADMAP</span>
        <h3 class="font-bold text-base text-slate-900 font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] mt-0.5">
          แผนทบทวน 6 รอบตามลำดับความสำคัญ (Priority A → B → C)
        </h3>
      </div>
      <span class="px-2 py-0.5 bg-slate-100 border border-slate-200 rounded-md text-[10px] text-slate-600 font-bold">
        RECOMMENDED SCHEDULE
      </span>
    </div>

    <div class="overflow-x-auto rounded-xl border border-slate-200">
      <table class="w-full text-left border-collapse">
        <thead class="bg-slate-50 text-slate-600 text-[11px] border-b border-slate-200">
          <tr>
            <th class="p-3 w-32 font-bold">รอบที่</th>
            <th class="p-3 font-bold">สิ่งที่ต้องทำ</th>
            <th class="p-3 w-32 font-bold">เวลาโดยประมาณ</th>
            <th class="p-3 w-28 text-center font-bold">สถานะ</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white text-slate-700">
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3 font-bold text-slate-900">R1 Diagnostic</td>
            <td class="p-3">ทำคำถาม Active Recall แบบปิดสไลด์ เพื่อวินิจฉัยจุดอ่อนของตนเอง</td>
            <td class="p-3 tabular-nums text-slate-500">60–90 นาที</td>
            <td class="p-3 text-center"><span class="px-2 py-0.5 rounded-md bg-blue-50 text-blue-700 font-bold text-[10px]">Step 1</span></td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3 font-bold text-rose-700">R2 Priority A</td>
            <td class="p-3">Responsible DS (Proxy, Obermeyer, Consent), Validation vs Test, Confusion Matrix</td>
            <td class="p-3 tabular-nums text-slate-500">90–120 นาที</td>
            <td class="p-3 text-center"><span class="px-2 py-0.5 rounded-md bg-rose-50 text-rose-700 font-bold text-[10px]">ด่วนที่สุด</span></td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3 font-bold text-amber-700">R3 Priority B</td>
            <td class="p-3">ฝึกคำนวณมือ: Gini Impurity/Gain, K-Means Centroid Update, Outlier Fences</td>
            <td class="p-3 tabular-nums text-slate-500">90–120 นาที</td>
            <td class="p-3 text-center"><span class="px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 font-bold text-[10px]">คำนวณมือ</span></td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3 font-bold text-slate-900">R4 Priority C</td>
            <td class="p-3">6 Data Roles, Decision Contract vs Memo, ห่วงโซ่ส่งมอบ และ Backtrack Task</td>
            <td class="p-3 tabular-nums text-slate-500">60–90 นาที</td>
            <td class="p-3 text-center"><span class="px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 font-bold text-[10px]">เชื่อมโยง</span></td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3 font-bold text-slate-900">R5 Mixed Mock</td>
            <td class="p-3">ทำข้อสอบจำลอง 14 ข้อใน Exam Arena จับเวลา 45 นาที และบันทึก Error Log</td>
            <td class="p-3 tabular-nums text-slate-500">90 นาที</td>
            <td class="p-3 text-center"><a href="/exam" class="text-blue-600 font-bold hover:underline">เข้าห้องสอบ →</a></td>
          </tr>
          <tr class="hover:bg-slate-50 transition-colors">
            <td class="p-3 font-bold text-emerald-700">R6 วันก่อนสอบ</td>
            <td class="p-3">อ่าน 5 ธีมหลัก ทบทวนตารางคู่สับสนบ่อย คำนวณสูตรมือ 1 ข้อ และพักผ่อนให้เพียงพอ</td>
            <td class="p-3 tabular-nums text-slate-500">45–60 นาที</td>
            <td class="p-3 text-center"><span class="px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 font-bold text-[10px]">พร้อมสอบ</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bottom: Actions & Storage Reset -->
  <div class="pt-4 border-t border-slate-200 flex flex-wrap justify-between items-center gap-4 text-xs font-mono">
    <div class="text-slate-500">
      สถานะการเรียนรู้ทั้งหมดถูกบันทึกลงในเบราว์เซอร์ของคุณโดยอัตโนมัติ (LocalStorage API)
    </div>
    <button
      type="button"
      id="reset-progress-btn"
      class="px-3 py-1.5 text-xs font-semibold text-rose-700 bg-rose-50 border border-rose-200 hover:bg-rose-100 rounded-lg transition-colors cursor-pointer"
    >
      รีเซ็ตข้อมูลความก้าวหน้าทั้งหมด
    </button>
  </div>
</Layout>

<script>
  import { ProgressStore } from '../lib/progress-store';
  import { allModules } from '../data/modules/index';

  function refreshDashboard() {
    const progress = ProgressStore.load();
    const totalModules = allModules.length;
    const totalFormulas = 14;

    const completedMods = progress.completedModuleIds.length;
    const masteredFormulas = progress.masteredFormulaIds.length;

    // Exam score from localStorage
    const lastScoreRaw = localStorage.getItem('ds_exam_last_score');
    const examScore = lastScoreRaw !== null ? Number(lastScoreRaw) : 0;
    const hasTakenExam = lastScoreRaw !== null;

    // Update numbers
    const modRatioEl = document.getElementById('stat-mod-ratio');
    const formulaRatioEl = document.getElementById('stat-formula-ratio');
    const examRatioEl = document.getElementById('stat-exam-ratio');

    if (modRatioEl) modRatioEl.textContent = `${completedMods} / ${totalModules}`;
    if (formulaRatioEl) formulaRatioEl.textContent = `${masteredFormulas} / ${totalFormulas}`;
    if (examRatioEl) examRatioEl.textContent = hasTakenExam ? `${examScore} / 14 ข้อ` : 'ยังไม่ได้สอบ';

    // Update Bars
    const modPct = Math.round((completedMods / totalModules) * 100);
    const formulaPct = Math.round((masteredFormulas / totalFormulas) * 100);
    const examPct = hasTakenExam ? Math.round((examScore / 14) * 100) : 0;

    const barMod = document.getElementById('bar-mod');
    const barFormula = document.getElementById('bar-formula');
    const barExam = document.getElementById('bar-exam');

    if (barMod) barMod.style.width = `${modPct}%`;
    if (barFormula) barFormula.style.width = `${formulaPct}%`;
    if (barExam) barExam.style.width = `${examPct}%`;

    // Overall Readiness Calculation
    const overallScore = Math.round((modPct * 0.3) + (formulaPct * 0.3) + (examPct * 0.4));
    const overallPctEl = document.getElementById('overall-pct');
    const overallStatusEl = document.getElementById('overall-status');

    if (overallPctEl) overallPctEl.textContent = `${overallScore}%`;
    if (overallStatusEl) {
      if (overallScore >= 80) overallStatusEl.textContent = 'พร้อมสอบระดับเกรด A 🎉';
      else if (overallScore >= 50) overallStatusEl.textContent = 'กำลังเตรียมตัวได้ดี ทวนจุดอ่อนเพิ่ม';
      else overallStatusEl.textContent = 'เพิ่งเริ่มต้น ทบทวนเนื้อหาและสูตร';
    }

    // Sync Checkboxes
    document.querySelectorAll<HTMLInputElement>('.mod-check').forEach((cb) => {
      const modId = cb.getAttribute('data-mod-id');
      cb.checked = modId ? progress.completedModuleIds.includes(modId) : false;
    });

    document.querySelectorAll<HTMLInputElement>('.formula-check').forEach((cb) => {
      const fId = cb.getAttribute('data-formula-id');
      cb.checked = fId ? progress.masteredFormulaIds.includes(fId) : false;
    });
  }

  // Checkbox Event Listeners
  document.querySelectorAll<HTMLInputElement>('.mod-check').forEach((cb) => {
    cb.addEventListener('change', () => {
      const modId = cb.getAttribute('data-mod-id');
      if (modId) {
        ProgressStore.toggleModuleCompleted(modId);
        refreshDashboard();
      }
    });
  });

  document.querySelectorAll<HTMLInputElement>('.formula-check').forEach((cb) => {
    cb.addEventListener('change', () => {
      const fId = cb.getAttribute('data-formula-id');
      if (fId) {
        ProgressStore.toggleFormulaMastered(fId);
        refreshDashboard();
      }
    });
  });

  // Reset Progress
  document.getElementById('reset-progress-btn')?.addEventListener('click', () => {
    if (confirm('คุณต้องการรีเซ็ตสถิติความก้าวหน้าทั้งหมดใช่หรือไม่?')) {
      localStorage.removeItem('ds_10301351_progress_v1');
      localStorage.removeItem('ds_exam_last_score');
      localStorage.removeItem('ds_exam_total');
      refreshDashboard();
    }
  });

  // Init
  refreshDashboard();
</script>
