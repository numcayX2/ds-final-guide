---
import Layout from '../layouts/Layout.astro';
import { allModules } from '../data/modules/index';
import ModuleStudyDrawer from '../components/modules/ModuleStudyDrawer.astro';

const visualHooks: Record<string, { label: string; formulaOrRule: string }> = {
  'module-01-crisp-ds': {
    label: 'MEMORY HOOK • 8 STEPS',
    formulaOrRule: 'Data Prep กินเวลา 60–80% | Quantitative vs Qualitative',
  },
  'module-02-data-cleaning': {
    label: 'MEMORY HOOK • CLEAN FIRST',
    formulaOrRule: 'ตัด Known Invalid (-40k, 904k) ก่อนหา Mean/Median + ติด Flag',
  },
  'module-03-feature-engineering': {
    label: 'MEMORY HOOK • NO LEAKAGE',
    formulaOrRule: 'Fit Scaler บน Train เท่านั้น | Z-Score ไม่เปลี่ยนรูปทรงความเบ้',
  },
  'module-04-eda-outliers': {
    label: 'VISUAL HOOK • BOXPLOT & TUKEY',
    formulaOrRule: 'Fence = Q1/Q3 ± 1.5(IQR) | ปลายหนวดหยุดที่ข้อมูลจริงในรั้ว!',
  },
  'module-05-modeling-framework': {
    label: 'VISUAL HOOK • 3-WAY SPLIT',
    formulaOrRule: 'Train 70% ↔ Val 15% (จูน) | 🔒 Test 15% (วัดผลครั้งเดียวตอนจบ)',
  },
  'module-06-decision-tree': {
    label: 'VISUAL HOOK • GINI & DEPTH',
    formulaOrRule: 'Cand.A Gain 0.222 ชนะ B (0.056) | Sweet Spot: max_depth = 3',
  },
  'module-07-evaluation-metrics': {
    label: 'VISUAL HOOK • CONFUSION MATRIX',
    formulaOrRule: 'แถว = Actual, คอลัมน์ = Pred | FIFA Prec 0.80 | HW#2 B Rec 0.90',
  },
  'module-08-kmeans': {
    label: 'VISUAL HOOK • 8 POINTS & INERTIA',
    formulaOrRule: 'Assign ใช้ Manhattan | Inertia ใช้ ||x−Ck||² | C2_new = (6,6)',
  },
  'module-09-responsible-ai': {
    label: 'VISUAL HOOK • BIAS & XAI',
    formulaOrRule: 'Postal Code = Proxy | Drift Recall 54% | Gate: Accept/Revise/Reject',
  },
};
---

<Layout title="10301351 Data Science Final Exam Guide - 9 บทเรียนเข้มข้น" activeTab="modules">
  <!-- Hero Section -->
  <section class="border-2 border-[#171719] bg-[#171719] text-[#F4F1EA] p-6 sm:p-10 mb-8 shadow-[6px_6px_0px_#A3E635] relative overflow-hidden">
    <div class="relative z-10 max-w-4xl">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="tape-label bg-[#A3E635] text-[#171719] text-xs py-0.5 px-2 font-black -rotate-1">
          SEMESTER 2/2025
        </span>
        <span class="tape-label bg-[#E11D48] text-white text-xs py-0.5 px-2 font-bold">
          LECTURES 01–09
        </span>
        <span class="text-xs font-mono text-gray-400">10301351 DATA SCIENCE</span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black font-['Space_Grotesk'] tracking-tight leading-none text-white mb-4">
        คู่มือพิชิตสอบ FINAL <br />
        <span class="text-[#A3E635]">10301351 DATA SCIENCE</span>
      </h1>

      <p class="text-sm sm:text-base font-mono text-gray-300 leading-relaxed max-w-2xl mb-6">
        รวบรวมเนื้อหา 100% ครบทุกสไลด์ ทุกสูตรคำนวณ ตัวอย่างจริง และข้อสอบอาจารย์ 
        ตั้งแต่ CRISP-DS 8 ขั้นตอน จนถึง Responsible AI พร้อมระบบแอนิเมชันสูตร KaTeX In-Equation Morphing
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href="/formulas"
          class="btn-chamfer px-5 py-3 bg-[#A3E635] text-[#171719] font-mono font-black text-sm uppercase border border-[#171719] shadow-[3px_3px_0px_#171719] hover:bg-[#84CC16] active:translate-x-0.5 active:translate-y-0.5 transition-all"
        >
          🚀 ดูแอนิเมชัน 14 สูตรคำนวณ →
        </a>
        <a
          href="/exam"
          class="btn-chamfer px-5 py-3 bg-white text-[#171719] font-mono font-bold text-sm uppercase border border-[#171719] shadow-[3px_3px_0px_#171719] hover:bg-[#EAE6DC] active:translate-x-0.5 active:translate-y-0.5 transition-all"
        >
          📝 เข้าสู่ห้องสอบจำลอง 14 ข้อ
        </a>
      </div>
    </div>

    <!-- Background Brutalist Accent Shape -->
    <div class="absolute -bottom-10 -right-10 text-[180px] font-black font-['Space_Grotesk'] text-white/[0.04] select-none pointer-events-none">
      FINAL
    </div>
  </section>

  <!-- Section 2: Study Modules List -->
  <section class="space-y-6">
    <div class="flex flex-wrap justify-between items-end gap-4 border-b-2 border-[#171719] pb-3">
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="w-3 h-3 bg-[#A3E635] border border-[#171719]"></span>
          <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#171719]">
            CURRICULUM MODULES • คลิกที่การ์ดเพื่อเปิดแผนภาพจำสอบและสรุปเจาะลึก
          </span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black font-['Space_Grotesk'] text-[#171719]">
          บทเรียน 9 บทสำหรับเตรียมสอบ
        </h2>
      </div>

      <!-- Chapter Filter Pills -->
      <div class="flex items-center gap-2 font-mono text-xs">
        <button
          type="button"
          id="filter-all-btn"
          class="px-3 py-1.5 border border-[#171719] bg-white text-[#171719] hover:bg-[#EAE6DC] font-bold cursor-pointer transition-all"
        >
          ทั้งหมด (9 บท)
        </button>
        <button
          type="button"
          id="filter-focus-btn"
          class="px-3 py-1.5 border border-[#171719] bg-[#A3E635] text-[#171719] font-black shadow-[2px_2px_0px_#171719] cursor-pointer transition-all"
        >
          เน้นสอบปลายภาค (Lect 05–09)
        </button>
      </div>
    </div>

    <!-- Modules Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="modules-grid">
      {allModules.map((mod) => {
        const hook = visualHooks[mod.id];
        return (
          <article
            class:list={[
              'module-card group relative border-2 border-[#171719] bg-white p-5 shadow-[4px_4px_0px_#171719] flex flex-col justify-between transition-all duration-150 hover:-translate-y-1 hover:shadow-[6px_6px_0px_#171719] cursor-pointer',
              mod.isFinalFocus ? 'is-focus-module' : 'is-foundation-module',
            ]}
            data-focus={mod.isFinalFocus ? 'true' : 'false'}
            data-open-module={mod.id}
            tabindex="0"
            role="button"
            aria-label={`เปิดสรุปเจาะลึกและแผนภาพของบทที่ ${mod.moduleNumber}: ${mod.title}`}
          >
            <div>
              <!-- Card Header -->
              <div class="flex justify-between items-start gap-2 mb-3">
                <div class="flex items-center gap-2">
                  <span class="w-8 h-8 bg-[#171719] text-[#A3E635] font-['Space_Grotesk'] font-bold text-sm flex items-center justify-center border border-[#171719] shrink-0">
                    {mod.moduleNumber}
                  </span>
                  <span
                    class="card-done-pill hidden px-1.5 py-0.5 bg-[#A3E635]/30 border border-[#171719] text-[10px] font-mono font-bold text-[#171719]"
                    data-card-badge={mod.id}
                  >
                    ✓ ทบทวนแล้ว
                  </span>
                </div>

                <div class="flex flex-wrap items-center gap-1.5 justify-end">
                  <span class="tape-label bg-[#F4F1EA] text-[#171719] text-[10px] py-0 px-1.5">
                    {mod.lectureCode}
                  </span>
                  <span class="px-1.5 py-0.5 bg-[#171719] text-white font-mono text-[10px] font-bold">
                    ~{mod.timeEstimateMinutes} นาที
                  </span>
                </div>
              </div>

              <!-- Title -->
              <h3 class="font-['Space_Grotesk'] font-bold text-lg text-[#171719] group-hover:text-[#2563EB] transition-colors leading-snug mb-2">
                {mod.title}
              </h3>

              <!-- Summary -->
              <p class="text-xs text-gray-700 leading-relaxed font-['Plus_Jakarta_Sans'] mb-3">
                {mod.quickSummary}
              </p>

              <!-- Visual Memory Key Strip -->
              {hook && (
                <div class="mb-3 p-2.5 bg-[#F4F1EA] border border-[#171719] font-mono">
                  <div class="flex items-center justify-between text-[10px] text-gray-500 font-bold mb-0.5">
                    <span>📊 {hook.label}</span>
                    <span class="text-[#2563EB] group-hover:underline">ดูแผนภาพเต็ม →</span>
                  </div>
                  <div class="text-[11px] font-bold text-[#171719] leading-snug">
                    {hook.formulaOrRule}
                  </div>
                </div>
              )}

              <!-- Exam Trap Box (Fixed non-squished header layout) -->
              {mod.examTraps && mod.examTraps.length > 0 && (
                <div class="p-2.5 bg-[#E11D48]/10 border-l-4 border-[#E11D48] text-[11px] font-mono mb-4">
                  <div class="flex items-center justify-between gap-1 text-[10px] font-bold text-[#BE123C] mb-1">
                    <span>⚠️ กับดักข้อสอบ ({mod.examTraps[0].slideRef})</span>
                    {mod.examTraps.length > 1 && (
                      <span class="px-1.5 py-0.2 bg-[#E11D48] text-white text-[9px]">
                        +{mod.examTraps.length - 1} จุดในบทนี้
                      </span>
                    )}
                  </div>
                  <div class="font-bold text-[#171719] leading-snug">
                    {mod.examTraps[0].trapTitle}
                  </div>
                  <p class="text-gray-700 mt-1 leading-normal line-clamp-2">
                    {mod.examTraps[0].correctApproach}
                  </p>
                </div>
              )}
            </div>

            <!-- Card Bottom Actions -->
            <div class="pt-3 border-t border-[#171719] flex flex-wrap justify-between items-center gap-2 text-xs font-mono">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1 font-bold text-[#171719] group-hover:text-[#2563EB] transition-colors">
                  <span>📖 เปิดสรุป + แผนภาพ</span>
                </span>
                {mod.coreFormulas && mod.coreFormulas.length > 0 && (
                  <a
                    href={`/formulas#${mod.coreFormulas[0]}`}
                    data-stop-card-open
                    class="px-1.5 py-0.5 bg-[#2563EB]/10 hover:bg-[#2563EB] text-[#2563EB] hover:text-white border border-[#2563EB] text-[10px] font-bold transition-colors"
                    title="ไปยังหน้าแอนิเมชันสูตรคำนวณ"
                  >
                    สูตร ({mod.coreFormulas.length}) →
                  </a>
                )}
              </div>

              <!-- Polished Read-Status Toggle Button (Zero Slop) -->
              <button
                type="button"
                data-stop-card-open
                class="module-mark-btn inline-flex items-center gap-1.5 px-2.5 py-1 border border-[#171719] text-[11px] font-bold bg-white text-gray-700 hover:bg-[#F4F1EA] hover:text-[#171719] transition-all cursor-pointer"
                data-mod-id={mod.id}
                aria-pressed="false"
              >
                <span class="mark-icon w-3.5 h-3.5 border border-[#171719] bg-white flex items-center justify-center text-[10px] leading-none"></span>
                <span class="mark-label">ทบทวนแล้ว</span>
              </button>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Ultra-Detail Visual Study Drawer Modal -->
  <ModuleStudyDrawer modules={allModules} />

  <!-- Section 3: 10-Minute Cheat Sheet Table (Zone B Clinical Grid) -->
  <section class="mt-12 border-2 border-[#171719] bg-white p-6 shadow-[5px_5px_0px_#171719]">
    <div class="border-b-2 border-[#171719] pb-3 mb-4 flex flex-wrap justify-between items-center gap-2">
      <div>
        <span class="tape-label bg-[#171719] text-[#A3E635] text-xs">10-MINUTE CHEAT SHEET</span>
        <h2 class="text-xl sm:text-2xl font-black font-['Space_Grotesk'] text-[#171719] mt-1">
          คลังสูตรเร่งด่วนสำหรับ 10 นาทีก่อนเข้าห้องสอบ
        </h2>
      </div>
      <span class="text-xs font-mono text-gray-500">14 Core Formulas Reference</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs font-mono border-collapse border border-[#171719]">
        <thead>
          <tr class="bg-[#171719] text-white text-[11px]">
            <th class="p-2 border border-[#171719]">ชื่อสูตร</th>
            <th class="p-2 border border-[#171719]">สมการคำนวณ</th>
            <th class="p-2 border border-[#171719]">วัตถุประสงค์ & คีย์เวิร์ดในข้อสอบ</th>
            <th class="p-2 border border-[#171719] text-center">ลิงก์แอนิเมชัน</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[#171719]/30">
          <tr class="hover:bg-[#F4F1EA]">
            <td class="p-2 font-bold border border-[#171719]/30">Min-Max Scaling</td>
            <td class="p-2 border border-[#171719]/30 tabular-nums">x' = [(x - min)/(max - min)] * (new_max - new_min) + new_min</td>
            <td class="p-2 border border-[#171719]/30">แปลงค่าเข้ากรอบ เช่น [0, 9] (ตัวอย่าง Rachel ได้ 0.82)</td>
            <td class="p-2 border border-[#171719]/30 text-center"><a href="/formulas#min-max" class="text-[#2563EB] font-bold hover:underline">ดูแอนิเมชัน →</a></td>
          </tr>
          <tr class="hover:bg-[#F4F1EA]">
            <td class="p-2 font-bold border border-[#171719]/30">Z-Score</td>
            <td class="p-2 border border-[#171719]/30 tabular-nums">z = (x - μ) / σ</td>
            <td class="p-2 border border-[#171719]/30">ข้อมูลอยู่ห่างจาก Mean กี่เท่าของ SD (ไม่เปลี่ยน Shape เดิม)</td>
            <td class="p-2 border border-[#171719]/30 text-center"><a href="/formulas#z-score" class="text-[#2563EB] font-bold hover:underline">ดูแอนิเมชัน →</a></td>
          </tr>
          <tr class="hover:bg-[#F4F1EA]">
            <td class="p-2 font-bold border border-[#171719]/30">Tukey's Fences</td>
            <td class="p-2 border border-[#171719]/30 tabular-nums">IQR = Q3 - Q1, Upper = Q3 + 1.5*IQR</td>
            <td class="p-2 border border-[#171719]/30">ตรวจจับ Outlier (Upper 130, จุด 140 หลุดรั้วบน)</td>
            <td class="p-2 border border-[#171719]/30 text-center"><a href="/formulas#tukey-fences" class="text-[#2563EB] font-bold hover:underline">ดูแอนิเมชัน →</a></td>
          </tr>
          <tr class="hover:bg-[#F4F1EA]">
            <td class="p-2 font-bold border border-[#171719]/30">Gini Impurity</td>
            <td class="p-2 border border-[#171719]/30 tabular-nums">Gini = 1 - ∑ (p_i)^2</td>
            <td class="p-2 border border-[#171719]/30">วัดความไม่บริสุทธิ์ (Pure node = 0, คละ 50:50 = 0.500)</td>
            <td class="p-2 border border-[#171719]/30 text-center"><a href="/formulas#gini-impurity" class="text-[#2563EB] font-bold hover:underline">ดูแอนิเมชัน →</a></td>
          </tr>
          <tr class="hover:bg-[#F4F1EA]">
            <td class="p-2 font-bold border border-[#171719]/30">Gini Gain</td>
            <td class="p-2 border border-[#171719]/30 tabular-nums">Gain = Gini(Parent) - Gini_split</td>
            <td class="p-2 border border-[#171719]/30">เลือกกิ่งที่ให้ Gain สูงสุด (Candidate A 0.222 ชนะ B 0.056)</td>
            <td class="p-2 border border-[#171719]/30 text-center"><a href="/formulas#gini-gain" class="text-[#2563EB] font-bold hover:underline">ดูแอนิเมชัน →</a></td>
          </tr>
          <tr class="hover:bg-[#F4F1EA]">
            <td class="p-2 font-bold border border-[#171719]/30">Precision</td>
            <td class="p-2 border border-[#171719]/30 tabular-nums">TP / (TP + FP)</td>
            <td class="p-2 border border-[#171719]/30">เน้นลด False Positive เมื่อการทายผิดมีต้นทุนสูง (FIFA 0.80)</td>
            <td class="p-2 border border-[#171719]/30 text-center"><a href="/formulas#precision" class="text-[#2563EB] font-bold hover:underline">ดูแอนิเมชัน →</a></td>
          </tr>
          <tr class="hover:bg-[#F4F1EA]">
            <td class="p-2 font-bold border border-[#171719]/30">Recall (Sensitivity)</td>
            <td class="p-2 border border-[#171719]/30 tabular-nums">TP / (TP + FN)</td>
            <td class="p-2 border border-[#171719]/30">เน้นลด False Negative เมื่อการพลาดเคสบวกเป็นหายนะ (FIFA 0.67)</td>
            <td class="p-2 border border-[#171719]/30 text-center"><a href="/formulas#recall" class="text-[#2563EB] font-bold hover:underline">ดูแอนิเมชัน →</a></td>
          </tr>
          <tr class="hover:bg-[#F4F1EA]">
            <td class="p-2 font-bold border border-[#171719]/30">F1-Score</td>
            <td class="p-2 border border-[#171719]/30 tabular-nums">2*TP / (2*TP + FP + FN)</td>
            <td class="p-2 border border-[#171719]/30">Harmonic Mean สมดุลความแม่นยำ (FIFA 0.73, HW#1 0.60)</td>
            <td class="p-2 border border-[#171719]/30 text-center"><a href="/formulas#f1-score" class="text-[#2563EB] font-bold hover:underline">ดูแอนิเมชัน →</a></td>
          </tr>
          <tr class="hover:bg-[#F4F1EA]">
            <td class="p-2 font-bold border border-[#171719]/30">K-Means Centroid Update</td>
            <td class="p-2 border border-[#171719]/30 tabular-nums">C_k = (∑ x1 / m, ∑ x2 / m)</td>
            <td class="p-2 border border-[#171719]/30">เฉลี่ยพิกัดจุดสมาชิกในคลัสเตอร์ (C2_new = (6, 6))</td>
            <td class="p-2 border border-[#171719]/30 text-center"><a href="/formulas#kmeans-distance-centroid" class="text-[#2563EB] font-bold hover:underline">ดูแอนิเมชัน →</a></td>
          </tr>
          <tr class="hover:bg-[#F4F1EA]">
            <td class="p-2 font-bold border border-[#171719]/30">Silhouette Score</td>
            <td class="p-2 border border-[#171719]/30 tabular-nums">s(i) = [b(i) - a(i)] / max(a(i), b(i))</td>
            <td class="p-2 border border-[#171719]/30">ประเมินคุณภาพคลัสเตอร์ [-1, +1] (+1 สมบูรณ์, ติดลบคือผิดกลุ่ม)</td>
            <td class="p-2 border border-[#171719]/30 text-center"><a href="/formulas#silhouette-score" class="text-[#2563EB] font-bold hover:underline">ดูแอนิเมชัน →</a></td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>
</Layout>

<script>
  import { ProgressStore } from '../lib/progress-store';

  const filterAllBtn = document.getElementById('filter-all-btn');
  const filterFocusBtn = document.getElementById('filter-focus-btn');
  const moduleCards = document.querySelectorAll<HTMLElement>('.module-card');
  const studyModal = document.getElementById('module-study-modal');
  const detailPanes = document.querySelectorAll<HTMLElement>('[data-module-pane]');

  // Filter handlers
  filterAllBtn?.addEventListener('click', () => applyFilter(false));
  filterFocusBtn?.addEventListener('click', () => applyFilter(true));

  // Listen to global focus change from header toggle
  window.addEventListener('final-focus-change', ((e: CustomEvent) => {
    applyFilter(e.detail.isFocus);
  }) as EventListener);

  function applyFilter(isFocus: boolean) {
    if (isFocus) {
      filterFocusBtn?.classList.add('bg-[#A3E635]', 'font-black', 'shadow-[2px_2px_0px_#171719]');
      filterFocusBtn?.classList.remove('bg-white', 'font-normal');
      filterAllBtn?.classList.remove('bg-[#A3E635]', 'font-black', 'shadow-[2px_2px_0px_#171719]');
      filterAllBtn?.classList.add('bg-white');

      moduleCards.forEach((card) => {
        if (card.getAttribute('data-focus') === 'true') {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    } else {
      filterAllBtn?.classList.add('bg-[#A3E635]', 'font-black', 'shadow-[2px_2px_0px_#171719]');
      filterAllBtn?.classList.remove('bg-white');
      filterFocusBtn?.classList.remove('bg-[#A3E635]', 'font-black', 'shadow-[2px_2px_0px_#171719]');
      filterFocusBtn?.classList.add('bg-white');

      moduleCards.forEach((card) => card.classList.remove('hidden'));
    }
  }

  // Sync read status UI across both Card buttons and Modal buttons
  function renderModuleMarkState(modId: string, isDone: boolean) {
    const buttons = document.querySelectorAll<HTMLElement>(`.module-mark-btn[data-mod-id="${modId}"]`);
    const badge = document.querySelector<HTMLElement>(`[data-card-badge="${modId}"]`);

    if (badge) {
      badge.classList.toggle('hidden', !isDone);
    }

    buttons.forEach((btn) => {
      btn.setAttribute('aria-pressed', isDone ? 'true' : 'false');
      const iconEl = btn.querySelector<HTMLElement>('.mark-icon');
      const labelEl = btn.querySelector<HTMLElement>('.mark-label');

      if (isDone) {
        btn.classList.add('bg-[#A3E635]', 'text-[#171719]', 'border-[#171719]', 'shadow-[2px_2px_0px_#171719]');
        btn.classList.remove('bg-white', 'text-gray-700', 'bg-[#222226]', 'text-[#F4F1EA]');
        if (iconEl) {
          iconEl.textContent = '✓';
          iconEl.classList.add('bg-[#171719]', 'text-[#A3E635]', 'border-[#171719]');
          iconEl.classList.remove('bg-white');
        }
        if (labelEl) {
          labelEl.textContent = 'ทบทวนแล้ว';
        }
      } else {
        btn.classList.remove('bg-[#A3E635]', 'text-[#171719]', 'shadow-[2px_2px_0px_#171719]');
        const isInsideModal = btn.closest('#module-study-modal') !== null;
        if (isInsideModal) {
          btn.classList.add('bg-[#222226]', 'text-[#F4F1EA]');
        } else {
          btn.classList.add('bg-white', 'text-gray-700');
        }
        if (iconEl) {
          iconEl.textContent = '';
          iconEl.classList.remove('bg-[#171719]', 'text-[#A3E635]');
          if (!isInsideModal) iconEl.classList.add('bg-white');
        }
        if (labelEl) {
          labelEl.textContent = isInsideModal ? 'ทำเครื่องหมายว่าทบทวนแล้ว' : 'ทบทวนแล้ว';
        }
      }
    });
  }

  // Initialize progress states
  const progress = ProgressStore.load();
  const allModIds = new Set<string>();
  document.querySelectorAll<HTMLElement>('.module-mark-btn').forEach((btn) => {
    const modId = btn.getAttribute('data-mod-id');
    if (modId) allModIds.add(modId);

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (!modId) return;
      const isDone = ProgressStore.toggleModuleCompleted(modId);
      renderModuleMarkState(modId, isDone);
    });
  });

  allModIds.forEach((modId) => {
    renderModuleMarkState(modId, progress.completedModuleIds.includes(modId));
  });

  // Prevent formula link clicks from triggering card modal
  document.querySelectorAll<HTMLElement>('[data-stop-card-open]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.stopPropagation();
    });
  });

  // Modal Open / Close / Switch Logic
  function openModuleModal(modId: string) {
    if (!studyModal) return;
    let found = false;
    detailPanes.forEach((pane) => {
      if (pane.getAttribute('data-module-pane') === modId) {
        pane.classList.remove('hidden');
        found = true;
      } else {
        pane.classList.add('hidden');
      }
    });
    if (!found) return;

    studyModal.classList.remove('hidden');
    studyModal.scrollTop = 0;
    document.body.style.overflow = 'hidden';
  }

  function closeModuleModal() {
    if (!studyModal) return;
    studyModal.classList.add('hidden');
    document.body.style.overflow = '';
  }

  moduleCards.forEach((card) => {
    const modId = card.getAttribute('data-open-module');
    if (!modId) return;

    card.addEventListener('click', () => {
      openModuleModal(modId);
    });

    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openModuleModal(modId);
      }
    });
  });

  document.querySelectorAll<HTMLElement>('[data-close-modal]').forEach((btn) => {
    btn.addEventListener('click', () => closeModuleModal());
  });

  document.querySelectorAll<HTMLElement>('[data-switch-module]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-switch-module');
      if (targetId) openModuleModal(targetId);
    });
  });

  studyModal?.addEventListener('click', (e) => {
    if (e.target === studyModal) {
      closeModuleModal();
    }
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && studyModal && !studyModal.classList.contains('hidden')) {
      closeModuleModal();
    }
  });

  // Init filter based on localStorage
  const savedFocus = localStorage.getItem('ds_final_focus');
  applyFilter(savedFocus !== null ? savedFocus === 'true' : true);
</script>
