---
import Layout from '../layouts/Layout.astro';
import GsapMorphPlayer from '../components/player/GsapMorphPlayer.astro';
import { allFormulas } from '../data/formulas/index';
---

<Layout title="10301351 Data Science - แอนิเมชัน 14 สูตรคำนวณ KaTeX + GSAP" activeTab="formulas">
  <!-- Page Header: Single Layer Container -->
  <div class="bg-white rounded-2xl p-6 sm:p-7 mb-8 border border-slate-200 shadow-xs">
    <div class="flex flex-wrap justify-between items-start gap-4">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-mono text-slate-500 mb-1">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-600"></span>
          <span>14 FORMULAS · IN-EQUATION MORPHING</span>
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold font-['Space_Grotesk',_'Google_Sans',_'Google_Sans_Thai',_sans-serif] text-slate-900 tracking-tight">
          แอนิเมชัน 14 สูตรคำนวณข้อสอบ Final
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-xl">
          ระบบแอนิเมชัน KaTeX In-Equation Morphing: ไฮไลต์และแทนที่ตัวเลขจริงในสมการทีละขั้นตอน พร้อมเสียงพากย์ภาษาไทย
        </p>
      </div>

      <!-- Quick Formula Jump Selector -->
      <div class="border border-slate-200 bg-slate-50 p-2.5 text-xs font-mono rounded-xl">
        <label for="formula-jump-select" class="block text-slate-500 text-[10px] uppercase mb-1 font-bold">
          เลือกกระโดดไปยังสูตร:
        </label>
        <select
          id="formula-jump-select"
          class="min-h-[36px] bg-white text-slate-900 border border-slate-200 rounded-lg px-2.5 py-1 text-xs sm:text-sm font-semibold font-mono outline-none cursor-pointer focus-visible:ring-2 focus-visible:ring-slate-900"
        >
          {allFormulas.map((f, i) => (
            <option value={f.id}>
              {String(i + 1).padStart(2, '0')}. {f.name} ({f.category})
            </option>
          ))}
        </select>
      </div>
    </div>
  </div>

  <!-- Formula Category Filter Buttons: rounded-lg Segmented Controls -->
  <div class="flex flex-wrap items-center gap-1.5 mb-8 font-mono text-xs">
    <button
      type="button"
      data-cat-filter="all"
      class="cat-filter-btn px-3 py-1.5 bg-slate-900 text-white font-semibold rounded-lg cursor-pointer outline-none transition-colors"
    >
      ทั้งหมด (14 สูตร)
    </button>
    <button
      type="button"
      data-cat-filter="evaluation"
      class="cat-filter-btn px-3 py-1.5 border border-slate-200 bg-white text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium rounded-lg cursor-pointer outline-none transition-colors"
    >
      Confusion Matrix & Metrics (4)
    </button>
    <button
      type="button"
      data-cat-filter="tree"
      class="cat-filter-btn px-3 py-1.5 border border-slate-200 bg-white text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium rounded-lg cursor-pointer outline-none transition-colors"
    >
      Decision Tree Gini (3)
    </button>
    <button
      type="button"
      data-cat-filter="clustering"
      class="cat-filter-btn px-3 py-1.5 border border-slate-200 bg-white text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium rounded-lg cursor-pointer outline-none transition-colors"
    >
      K-Means & Silhouette (2)
    </button>
    <button
      type="button"
      data-cat-filter="eda"
      class="cat-filter-btn px-3 py-1.5 border border-slate-200 bg-white text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium rounded-lg cursor-pointer outline-none transition-colors"
    >
      EDA Outliers (1)
    </button>
    <button
      type="button"
      data-cat-filter="scaling"
      class="cat-filter-btn px-3 py-1.5 border border-slate-200 bg-white text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium rounded-lg cursor-pointer outline-none transition-colors"
    >
      Feature Scaling (2)
    </button>
    <button
      type="button"
      data-cat-filter="cleaning"
      class="cat-filter-btn px-3 py-1.5 border border-slate-200 bg-white text-slate-600 hover:text-slate-900 hover:bg-slate-50 font-medium rounded-lg cursor-pointer outline-none transition-colors"
    >
      Data Cleaning (2)
    </button>
  </div>

  <!-- Formula Players List -->
  <div class="space-y-10 min-w-0 max-w-full overflow-hidden" id="formulas-list">
    {allFormulas.map((formula, idx) => (
      <section
        id={formula.id}
        class="formula-section scroll-mt-20 min-w-0 max-w-full overflow-hidden"
        data-category={formula.category}
        data-focus={formula.isFinalFocus ? 'true' : 'false'}
      >
        <div class="flex items-center gap-2 mb-2 font-mono text-xs">
          <span class="w-6 h-6 bg-slate-100 text-slate-800 border border-slate-200 rounded-md flex items-center justify-center font-bold text-xs">
            {idx + 1}
          </span>
          <span class="font-bold text-slate-500 uppercase">
            สูตรที่ {idx + 1} จาก 14 • หมวด {formula.category.toUpperCase()}
          </span>
        </div>

        <GsapMorphPlayer formula={formula} />
      </section>
    ))}
  </div>
</Layout>

<script>
  // Formula Category Filters
  const filterBtns = document.querySelectorAll<HTMLElement>('.cat-filter-btn');
  const formulaSections = document.querySelectorAll<HTMLElement>('.formula-section');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => {
        b.classList.remove('bg-slate-900', 'text-white');
        b.classList.add('bg-white', 'text-slate-600', 'border', 'border-slate-200');
      });
      btn.classList.add('bg-slate-900', 'text-white');
      btn.classList.remove('bg-white', 'text-slate-600', 'border', 'border-slate-200');

      const targetCat = btn.getAttribute('data-cat-filter');
      formulaSections.forEach((sec) => {
        if (targetCat === 'all' || sec.getAttribute('data-category') === targetCat) {
          sec.classList.remove('hidden');
        } else {
          sec.classList.add('hidden');
        }
      });
    });
  });

  // Jump to formula select
  const jumpSelect = document.getElementById('formula-jump-select') as HTMLSelectElement;
  jumpSelect?.addEventListener('change', () => {
    const targetId = jumpSelect.value;
    const targetEl = document.getElementById(targetId);
    if (targetEl) {
      targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  // Check URL hash on load
  if (window.location.hash) {
    const hashId = window.location.hash.substring(1);
    const targetEl = document.getElementById(hashId);
    if (targetEl) {
      setTimeout(() => {
        targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }, 300);
    }
  }
</script>
